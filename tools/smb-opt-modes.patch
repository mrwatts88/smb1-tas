+    let sl16 = screen_left_abs(x, s.left_screen_edge_pos);
+    let m = clamp(x - sl16 - REL_TRACK, M_LO, M_HI);
+    if x > WALL + m { return 0; } // beyond the refusal wall: not a surviving state
+    let y = clamp((s.y_pos >> 8) - 0x100, 0, NY - 1);
+    let c = if s.side_collision_timer > 0 { self.cmax } else { 0 };
+    let d = self.dist[self.idx(x, y, m, c)];
+    if d == INF { 1000 } else { d as Dist }
+  }
+  /// The relaxed distance table entry for a (X, Y, m, credit) query (tests / traces).
+  pub fn h_at(&self, x: i32, y: i32, m: i32, c: i32) -> u16 {
