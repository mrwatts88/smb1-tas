+/// The revive direction uses FrameCounter & 1 (= fc_odd); exposed for tests.
+pub fn fc_odd_of_frame<O: BlockStates>(frame: u8) -> bool { ((O::FC0 as u16 + frame as u16) & 1) != 0 }
