@@ -0,0 +1,458 @@
+//! P2.5c-2 — the 4-2 main-area enemies as a per-step object hook for `W42Main` (`--enemies`): the enemy-data loader
+//! (`ProcessEnemyData`), the `$3A` goomba group, the green koopa, the buzzy beetles, the piranha plants the area
+//! parser inserts into the pipes, and the lift's slot occupancy, with the per-slot RAM packed into the record's ext
+//! bytes. A line-by-line port of `tools/w42_enemy_sim.py` (validated on the WR dump: F99/F100; shell/fall rules
+//! asm-sourced, `docs/experiments/P2.5c-notes-*.md`), driven by the model's own state: the scroll
+//! (`left_screen_edge_pos`), the parser schedule and frame/interval-timer phases (`State.blocks`), the block buffer
+//! BB42 and Mario's post-step position/speed.
+//!
+//! Ext layout (64 bytes): [0..2] the lift's u16 (as `w42_lift`: 0x100|aptn before the spawn, k frames since, 0x200
+//! after the erase); [2] enemy-data offset (`EnemyDataOffset`); [3] `EnemyObjectPageLoc` | page-select << 7;
+//! [4..64] six slots of 10 bytes as described at `Slot::pack`.
+use blockbuffer::BlockBuffer;
+use blockbuffer::world4::BB42;
+use options::BlockStates;
+use state::State;
+
+/// `E_UndergroundArea2` (tools/area_data.py): page-skip to page 2, the page-2 area change, the `$3A` group at col 14,
+/// the lift `$27` at page 3 col 10, the koopa `$00` at page 4 col 13, the beetles `$02` at page 5 cols 3 and 8, the
+/// page-5 area change, then the objects after the wrong-warp pipe (never reached by the search: the pipe is the goal).
+pub const ENEMY_DATA: [u8; 46] = [0x0f, 0x02, 0x1e, 0x2f, 0x60, 0xe0, 0x3a, 0xa5, 0xa7, 0xdb, 0x80, 0x3b, 0x82, 0x8b, 0x02, 0xfe, 0x42, 0x68, 0x70, 0xbb, 0x25, 0xa7, 0x2c, 0x27, 0xb2, 0x26, 0xb9, 0x26, 0x9b, 0x80, 0xa8, 0x82, 0xb5, 0x27, 0xbc, 0x27, 0xb0, 0xbb, 0x3b, 0x82, 0x87, 0x34, 0xee, 0x25, 0x6b, 0xff];
+/// Vertical pipes of BB42 (left column, top row): the area parser spawns a piranha plant when it renders the left
+/// column (F100). Col 84 is the wrong-warp pipe (goal), col 89 pipe C.
+pub const PIPES: [(u8, u8); 4] = [(72, 8), (78, 4), (84, 8), (89, 8)];
+
+pub const CLASS_EMPTY: u8 = 0; pub const CLASS_GOOMBA: u8 = 1; pub const CLASS_KOOPA: u8 = 2; pub const CLASS_BEETLE: u8 = 3;
+pub const CLASS_PLANT: u8 = 4; pub const CLASS_LIFT: u8 = 5; pub const CLASS_ITEM: u8 = 6;
+/// H34: the vine. The (64,3) bump runs `Setup_Vine` with X=5 (the special slot: x 1024, y 80, growing); the enemy
+/// loader's `CheckFrenzyBuffer` then injects ONE inert `VineObject` into the first free normal slot whose loader
+/// turn finds no level enemy in range (its init is `Setup_Vine` again, which raises `VineFlagOffset` to 2 and stops
+/// further injection; its position copy reads garbage and the object is never run/collided/bounds-checked — pure
+/// slot occupancy, which is what blocks the wrong-warp plant, F100). `KillVine` (run on slot 5's turn) erases every
+/// vine object once the slot-5 vine is moderately offscreen left (bits %00001100) and clears the flag.
+pub const CLASS_VINE: u8 = 7;
+const ID_OF_CLASS: [u8; 8] = [0, 0x06, 0x00, 0x02, 0x0d, 0x27, 0x2e, 0x2f];
+fn class_of_id(id: u8) -> u8 { match id { 0x06 => CLASS_GOOMBA, 0x00 => CLASS_KOOPA, 0x02 => CLASS_BEETLE, 0x0d => CLASS_PLANT, 0x27 => CLASS_LIFT, 0x2f => CLASS_VINE, _ => CLASS_ITEM } }
+
+const SETBITS: [u8; 7] = [0x80, 0x40, 0x20, 0x10, 0x08, 0x04, 0x02];
+const XOFF: [u8; 16] = [0x7f, 0x3f, 0x1f, 0x0f, 0x07, 0x03, 0x01, 0x00, 0x80, 0xc0, 0xe0, 0xf0, 0xf8, 0xfc, 0xfe, 0xff];
+const BGC_STATE: [u8; 6] = [1, 1, 2, 2, 2, 5];
+const XSPD_ADDER: [u8; 4] = [0x00, 0xe8, 0x00, 0x18];
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum EnemyEvent { Nothing, Stomp, Kick, Death }
+
+/// One enemy slot (the RAM the rules read/write). `up` doubles as `Enemy_YMF_Dummy` (walkers) / `PiranhaPlantUpYPos`.
+#[derive(Clone, Copy, Default, Debug, PartialEq, Eq)]
+pub struct Slot {
+  pub class: u8, pub state: u8, pub x: u16, pub y: u8, pub spd: u8, pub force: u8, pub dir: u8,
+  pub itimer: u8, pub ftimer: u8, pub masked: bool, pub cbits: u8, pub yspd: u8, pub yforce: u8, pub up: u8, pub dn: u8, pub yhi: u8,
+}
+impl Slot {
+  pub fn id(&self) -> u8 { ID_OF_CLASS[self.class as usize] }
+  pub fn live(&self) -> bool { self.class != CLASS_EMPTY }
+  /// 10 bytes: [0] class:3 | dir:1 | pair bits for upper slots 4,5 ($08,$04):2 | masked:1 | plant travelling up:1;
+  /// [1] state; [2] x lo; [3] x hi:4 | d0:1 | pair bits for upper slots 1..3 ($40,$20,$10):3; [4] y; [5] x move force;
+  /// [6] interval timer (walkers) / frame timer (plants); [7] y move force / plant down position; [8] y speed /
+  /// plant move flag; [9] Enemy_YMF_Dummy (the vertical sub-pixel accumulator). The horizontal speed is a function
+  /// of (class, state, dir) for everything the search can produce (walkers ±8, kicked shells ±$30, defeated ±$10);
+  /// a slot whose y wrapped below the screen (Enemy_Y_HighPos 2) is erased in the same step and never stored.
+  fn pack(&self, b: &mut [u8]) {
+    let cb = self.cbits;
+    let plant = self.class == CLASS_PLANT;
+    b[0] = (self.class & 7) | ((self.dir & 1) << 3) | (((cb >> 3) & 1) << 4) | (((cb >> 2) & 1) << 5) | ((self.masked as u8) << 6)
+      | (((plant && self.spd & 0x80 != 0) as u8) << 7);
+    b[1] = self.state;
+    b[2] = (self.x & 0xff) as u8;
+    b[3] = ((self.x >> 8) & 0x0f) as u8 | ((cb & 1) << 4) | (((cb >> 6) & 1) << 5) | (((cb >> 5) & 1) << 6) | (((cb >> 4) & 1) << 7);
+    b[4] = self.y;
+    b[5] = self.force;
+    b[6] = if plant { self.ftimer } else { self.itimer };
+    b[7] = if plant { self.dn } else { self.yforce };
+    b[8] = if plant { self.yspd & 1 } else { self.yspd };
+    b[9] = if plant { 0 } else { self.up };
+  }
+  fn unpack(b: &[u8]) -> Slot {
+    let class = b[0] & 7;
+    let cb = ((b[3] >> 4) & 1) | (((b[3] >> 5) & 1) << 6) | (((b[3] >> 6) & 1) << 5) | (((b[3] >> 7) & 1) << 4) | (((b[0] >> 4) & 1) << 3) | (((b[0] >> 5) & 1) << 2);
+    let mut s = Slot { class, state: b[1], x: b[2] as u16 | (((b[3] & 0x0f) as u16) << 8), y: b[4], force: b[5],
+      dir: if b[0] & 8 != 0 { 1 } else { 2 }, masked: b[0] & 0x40 != 0, yhi: 1, cbits: cb, ..Default::default() };
+    if class == CLASS_EMPTY { s.up = b[9]; s.yforce = b[7]; s.yspd = b[8]; }   // stale slot memory survives an erase
+    else if class == CLASS_PLANT {
+      s.ftimer = b[6]; s.dn = b[7]; s.up = s.dn.wrapping_sub(24);
+      s.yspd = b[8] & 1; s.spd = if b[0] & 0x80 != 0 { 0xff } else { 1 };
+    } else {
+      s.itimer = b[6]; s.yforce = b[7]; s.yspd = b[8]; s.up = b[9];
+      s.spd = Slot::speed_of(class, s.state, s.dir);
+    }
+    s
+  }
+  /// The horizontal speed for (class, state, dir): walkers ±8, kicked shells ±$30, defeated ±$10, lift/items 0.
+  fn speed_of(class: u8, state: u8, dir: u8) -> u8 {
+    if class == CLASS_LIFT || class == CLASS_ITEM || class == CLASS_VINE { return 0; }
+    let mag: u8 = if state & 0x20 != 0 { 0x10 } else if state & 0x80 != 0 { 0x30 } else { 0x08 };
+    if dir == 1 { mag } else { mag.wrapping_neg() }
+  }
+}
+
+/// The packed enemy state of a record. `vineflag` = `VineFlagOffset` (0 none, 1 bumped/injection pending, 2 both
+/// vine objects placed), packed into ext[3] bits 5..6 (the page is ≤ 5, so those bits were always 0 before H34:
+/// bump-free records stay byte-identical).
+pub struct Slots { pub eoff: u8, pub epage: u8, pub epsel: bool, pub vineflag: u8, pub s: [Slot; 6] }
+impl Slots {
+  pub fn unpack(ext: &[u8]) -> Slots {
+    let mut s = [Slot::default(); 6];
+    for i in 0..6 { s[i] = Slot::unpack(&ext[4 + 10 * i..14 + 10 * i]); }
+    Slots { eoff: ext[2], epage: ext[3] & 0x1f, epsel: ext[3] & 0x80 != 0, vineflag: (ext[3] >> 5) & 3, s }
+  }
+  pub fn pack(&self, ext: &mut [u8]) {
+    ext[2] = self.eoff; ext[3] = (self.epage & 0x1f) | ((self.vineflag & 3) << 5) | ((self.epsel as u8) << 7);
+    for i in 0..6 { self.s[i].pack(&mut ext[4 + 10 * i..14 + 10 * i]); }
+  }
+  pub fn describe(&self) -> String {
+    let mut out = format!("eoff {} epage {}{}{}", self.eoff, self.epage, if self.epsel { "+" } else { "" }, if self.vineflag != 0 { format!(" vf{}", self.vineflag) } else { String::new() });
+    for (i, s) in self.s.iter().enumerate() {
+      if !s.live() { continue; }
+      out.push_str(&format!(" | s{} id{:02x} st{:02x} x{} y{} spd{:02x} f{:02x} d{} it{} ft{} m{} cb{:02x} ys{:02x} yf{:02x}", i, s.id(), s.state, s.x, s.y, s.spd, s.force, s.dir, s.itimer, s.ftimer, s.masked as u8, s.cbits, s.yspd, s.yforce));
+    }
+    out
+  }
+}
+
+#[inline] fn block_at(x16: i32, ypx: i32) -> u8 {
+  if ypx < 32 { return 0; }
+  let r = (ypx - 32) >> 4; let c = x16 >> 4;
+  if r < 0 || r > 12 || c < 0 || c >= 98 { return 0; }
+  <BB42 as BlockBuffer>::get_block_at(c as usize, r as usize)
+}
+#[inline] fn non_solid(cv: u8) -> bool { cv == 0 || cv == 0x26 || cv == 0xc2 || cv == 0xc3 || cv == 0x5f || cv == 0x60 }
+fn x_offscreen_bits(x16: i32, sl16: i32) -> u8 {
+  let sr16 = sl16 + 255;
+  for &(y, edge) in &[(1, sr16), (0, sl16)] {
+    let diff = edge - x16;
+    let lo = (diff & 0xff) as i32;
+    let hi = diff >> 8;
+    let mut idx: usize = if y == 1 { 0x07 } else { 0x0f };
+    if hi < 0 { idx = if y == 1 { 0x0f } else { 0x07 }; }
+    else if hi >= 1 { idx = if y == 1 { 0x07 } else { 0x0f }; }
+    else if lo < 0x38 { idx = ((lo >> 3) & 7) as usize; if y == 0 { idx += 8; } }
+    let bits = XOFF[idx];
+    if bits != 0 { return bits; }
+  }
+  0
+}
+#[inline] fn overlap(a: (u8, u8, u8, u8), b: (u8, u8, u8, u8)) -> bool { a.0 <= b.2 && b.0 <= a.2 && a.1 <= b.3 && b.1 <= a.3 }
+fn turn_around(s: &mut Slot) { s.spd = s.spd.wrapping_neg(); s.dir ^= 3; }
+/// EraseEnemyObject (9173-9183): clears flag/id/state/timers; x, y, speeds, move force, collision bits, dir and the
+/// sub-pixel accumulators stay as stale slot memory for the next occupant.
+fn erase(s: &mut Slot) { s.class = CLASS_EMPTY; s.state = 0; s.itimer = 0; s.ftimer = 0; }
+/// A fresh occupant of a slot: everything the spawner/init writes, with the stale fields kept.
+fn occupy(s: &mut Slot, class: u8, x: u16, y: u8) { s.class = class; s.state = 0; s.x = x; s.y = y; s.itimer = 0; s.ftimer = 0; s.yhi = 1; s.dn = 0; }
+/// MoveObjectHorizontally: force += (speed << 4), x += sign-extended (speed >> 4) + carry.
+fn move_h(s: &mut Slot) {
+  let lo = (s.spd << 4) & 0xff;
+  let hi = s.spd >> 4;
+  let hi_s: i32 = if hi >= 8 { hi as i32 - 16 } else { hi as i32 };
+  let total = s.force as u16 + lo as u16;
+  let carry = if total > 0xff { 1 } else { 0 };
+  s.force = (total & 0xff) as u8;
+  s.x = (s.x as i32 + hi_s + carry) as u16 & 0x0fff;
+}
+fn gravity(s: &mut Slot) {
+  let t = s.up as u16 + s.yforce as u16; let c1 = (t >> 8) as u8; s.up = (t & 0xff) as u8;
+  let hi = if s.yspd & 0x80 != 0 { 0xff } else { 0 };
+  let y = s.y as u16 + s.yspd as u16 + c1 as u16; let c2 = (y >> 8) as u8; s.y = (y & 0xff) as u8;
+  s.yhi = s.yhi.wrapping_add(hi).wrapping_add(c2);
+  let f = s.yforce as u16 + 0x3d; let c3 = (f >> 8) as u8; s.yforce = (f & 0xff) as u8;
+  s.yspd = s.yspd.wrapping_add(c3);
+  if s.yspd.wrapping_sub(3) < 0x80 && s.yforce >= 0x80 { s.yspd = 3; s.yforce = 0; }
+}
+fn steady(s: &mut Slot, mut y: usize) {
+  let saved = s.spd;
+  if saved & 0x80 != 0 { y += 2; }
+  s.spd = saved.wrapping_add(XSPD_ADDER[y]);
+  move_h(s);
+  s.spd = saved;
+}
+fn fall_e(s: &mut Slot) {
+  gravity(s);
+  if s.state == 2 { move_h(s); }
+  else if s.state & 0x40 == 0 || s.class == CLASS_ITEM { steady(s, 0); }
+  else { steady(s, 1); }
+}
+fn landing(s: &mut Slot) { s.yspd = 0; s.yforce = 0; s.y = (s.y & 0xf0) | 0x08; }
+fn land_init(s: &mut Slot) { landing(s); if s.state & 0x80 != 0 { s.state &= 0xbf; } else { s.state = 0; } }
+fn defeat(s: &mut Slot, px: i32) {
+  s.state = (s.state & 0xf0) | 2;
+  s.y = s.y.wrapping_sub(2);
+  s.yspd = 0xfd;
+  s.dir = if s.x as i32 >= px { 1 } else { 2 };
+  s.spd = if s.dir == 1 { 0x10 } else { 0xf0 };
+  s.state = (s.state & 0x1f) | 0x20;
+}
+fn side_check(s: &mut Slot) {
+  if s.y < 0x20 { return; }
+  let probe = s.x as i32 + if s.dir == 2 { 0 } else { 16 };
+  let cv = block_at(probe, s.y as i32 + 20);
+  if cv != 0 && !non_solid(cv) { turn_around(s); }
+}
+fn bg_collision(s: &mut Slot, px: i32, bounce_cell: u16) {
+  if s.state & 0x20 != 0 { return; }
+  if ((s.y as i32 + 0x3e) & 0xff) < 0x44 { return; }
+  if s.class == CLASS_PLANT { return; }
+  let ux = s.x as i32 + 8; let uy = s.y as i32 + 24;
+  let mut under = block_at(ux, uy);
+  if uy >= 32 && bounce_cell == 1 + (((ux >> 4) as u16) << 4 | (((uy - 32) >> 4) as u16)) { under = 0x23; }
+  if under != 0 && !non_solid(under) && 8 <= (s.y & 0x0f) && (s.y & 0x0f) <= 0x0c {
+    if under == 0x23 {
+      // a block bumped from below: KillEnemyAboveBlock (goomba) / stun (others) — ShellOrBlockDefeat then y speed $fc
+      defeat(s, px); s.yspd = 0xfc; return;
+    }
+    let st = s.state;
+    if st & 0x40 != 0 { land_init(s); }
+    else if st & 0x80 != 0 { side_check(s); }
+    else if st == 0 { side_check(s); }
+    else if st == 1 {
+      if s.class != CLASS_GOOMBA { let want = if s.x as i32 >= px { 1 } else { 2 }; if want == s.dir { turn_around(s); } }
+      land_init(s);
+    } else if st == 2 { s.itimer = 0x10; s.state = 3; landing(s); }
+  } else {
+    if s.state & 0x80 != 0 { s.state |= 0x40; }
+    else if s.state < 6 { s.state = BGC_STATE[s.state as usize]; }
+    side_check(s);
+  }
+}
+/// MovePiranhaPlant (10577-10634).
+fn move_plant(s: &mut Slot, fc_odd: bool, px: i32) {
+  if s.state != 0 || s.ftimer != 0 { return; }
+  if s.yspd == 0 {
+    if s.spd & 0x80 == 0 {
+      let diff = s.x as i32 - px;
+      let mut d8 = diff & 0xff;
+      if diff < 0 { d8 = (-d8) & 0xff; }
+      if d8 < 0x21 { return; }
+    }
+    s.spd = s.spd.wrapping_neg();
+    s.yspd += 1;
+  }
+  let end = if s.spd & 0x80 != 0 { s.up } else { s.dn };
+  if !fc_odd { return; }
+  s.y = s.y.wrapping_add(s.spd);
+  if s.y == end { s.yspd = 0; s.ftimer = 0x40; }
+}
+fn init_enemy(s: &mut Slot) {
+  s.masked = true; s.yhi = 1;   // CheckpointEnemyID: EnemyOffscrBitsMasked = 1
+  match s.class {
+    CLASS_GOOMBA | CLASS_KOOPA | CLASS_BEETLE => { s.spd = 0xf8; s.dir = 2; s.yspd = 0; s.yforce = 0; }   // InitNormalEnemy / SetBBox / InitVStf
+    _ => { s.dir = 2; }
+  }
+}
+
+/// `bx`/`by`: the player's position after movement and before PlayerBGCollision (emu::pre_bg_pos) — the game builds
+/// the player's hitbox from it (BoundingBoxCore before PlayerBGCollision), so a landing snap or a wall push-back in
+/// the same frame does not move the box (F101); `px`/`py` are the final position (CheckPlayerVertical, plant range).
+pub struct Frame { pub sl16: i32, pub fc_odd: bool, pub fc_b1: bool, pub itc_tick: bool, pub aptn_pre: u8, pub px: i32, pub py: i32, pub bx: i32, pub by: i32, pub pys_pos: bool, pub bounce_cell: u16 }
+
+impl Slots {
+  /// ProcessEnemyData for free slot `slot` (CheckRightBounds / CheckRightExtBounds / HandleGroupEnemies).
+  /// Returns true on the paths that fall through to `CheckFrenzyBuffer` in the game (the EOD terminator and
+  /// "beyond the extended right boundary") — where the H34 vine injection can happen.
+  fn process_enemy_data(&mut self, slot: usize, sl16: i32) -> bool {
+    let sr16 = sl16 + 255;
+    let ext16 = (sr16 + 48) & !15;
+    loop {
+      let off = self.eoff as usize;
+      if off + 1 >= ENEMY_DATA.len() { return true; }
+      let b0 = ENEMY_DATA[off];
+      if b0 == 0xff { return true; }
+      let row = b0 & 0x0f;
+      if row != 0x0e && slot >= 5 { if (ENEMY_DATA[off + 1] & 0x3f) != 0x2e { return false; } }
+      let b1 = ENEMY_DATA[off + 1];
+      if b1 & 0x80 != 0 && !self.epsel { self.epsel = true; self.epage += 1; }
+      if row == 0x0f && !self.epsel { self.epage = b1 & 0x3f; self.eoff += 2; self.epsel = true; continue; }
+      let x16 = self.epage as i32 * 256 + (b0 & 0xf0) as i32;
+      if x16 < sr16 { self.eoff += if row == 0x0e { 3 } else { 2 }; self.epsel = false; return false; }
+      if x16 > ext16 { return true; }
+      if row == 0x0e { self.eoff += 3; self.epsel = false; return false; }
+      if b1 & 0x40 != 0 { self.eoff += 2; self.epsel = false; return false; }
+      let eid = b1 & 0x3f;
+      if 0x37 <= eid && eid < 0x3f {
+        let v = eid - 0x37;
+        let n = if v & 1 != 0 { 3 } else { 2 };
+        let y: u8 = if v & 2 != 0 { 0x70 } else { 0xb0 };
+        let class = if v < 4 { CLASS_GOOMBA } else { CLASS_KOOPA };
+        let mut gx = sr16;
+        for _ in 0..n {
+          let free = (0..5).find(|&i| !self.s[i].live());
+          let free = match free { Some(i) => i, None => break };
+          let t = &mut self.s[free];
+          occupy(t, class, (gx & 0x0fff) as u16, y + 8);
+          init_enemy(t);
+          gx += 24;
+        }
+      } else {
+        let t = &mut self.s[slot];
+        occupy(t, class_of_id(eid), (x16 & 0x0fff) as u16, (row << 4) + 8);
+        init_enemy(t);
+      }
+      self.eoff += 2; self.epsel = false;
+      return false;
+    }
+  }
+
+  /// One frame of the six enemy slots after Mario's step (EnemiesAndLoopsCore / RunNormalEnemies order), plus the
+  /// parser's plant spawn if this frame ran a render task on a pipe column. Returns the player-relevant event and
+  /// applies the stomp bounce to `s`.
+  pub fn step(&mut self, f: &Frame, s: &mut State, lift_live: &mut bool, plant_col: Option<u8>) -> EnemyEvent {
+    let sr16 = f.sl16 + 255;
+    // NMI: interval timers on the wrap frames, frame timers every frame (TimerControl is 0 on every searched frame)
+    for sl in self.s.iter_mut() {
+      if !sl.live() || sl.class == CLASS_LIFT || sl.class == CLASS_ITEM || sl.class == CLASS_VINE { continue; }
+      if f.itc_tick && sl.itimer > 0 { sl.itimer -= 1; }
+      if sl.ftimer > 0 { sl.ftimer -= 1; }
+    }
+    let mut stomp_timer = 0u8;
+    let mut ev = EnemyEvent::Nothing;
+    let prelx = ((f.bx - f.sl16) & 0xff) as u8;   // RelativePlayerPosition + BoundingBoxCore before PlayerBGCollision (F101)
+    let pbox = (prelx.wrapping_add(3), (f.by + 20) as u8, prelx.wrapping_add(13), (f.by + 32) as u8);
+    let player_ok = f.py < 0xd0;
+    let mut boxes: [Option<(u8, u8, u8, u8)>; 6] = [None; 6];
+    for i in 0..6 {
+      if self.s[i].class == CLASS_LIFT {
+        if !*lift_live { erase(&mut self.s[i]); }
+        continue;
+      }
+      if self.s[i].class == CLASS_ITEM || self.s[i].class == CLASS_VINE { continue; }   // vine slots: inert (slot 5's growth/KillVine run after the loop)
+      if !self.s[i].live() {
+        if (f.aptn_pre & 7) != 7 {
+          let frenzy = self.process_enemy_data(i, f.sl16);
+          // CheckFrenzyBuffer: reached only on the loader's "no level enemy here" paths (EOD / beyond the
+          // extended right boundary). With VineFlagOffset == 1 it stores VineObject into this free slot; the
+          // vine's init is Setup_Vine again, which raises the flag to 2 — exactly one injection. The object is
+          // inert (run = VineObjectHandler, exits off slot 5; position copy is garbage and never used).
+          if frenzy && self.vineflag == 1 {
+            occupy(&mut self.s[i], CLASS_VINE, 0, 0);
+            self.vineflag = 2;
+          }
+        }
+        if self.s[i].class == CLASS_LIFT { *lift_live = true; }
+        continue;
+      }
+      let mut sl = self.s[i];
+      // RunNormalEnemies: offscreen bits, bounding box
+      let bits = x_offscreen_bits(sl.x as i32, f.sl16) >> 4;
+      let mask = if sl.x as i32 <= f.sl16 { 0x44 } else { 0x48 };
+      sl.masked = bits & mask != 0;
+      let relx = ((sl.x as i32 - f.sl16) & 0xff) as u8;
+      let bb = if sl.masked { None } else if sl.class == CLASS_GOOMBA || sl.class == CLASS_PLANT { Some((relx.wrapping_add(3), sl.y.wrapping_add(14), relx.wrapping_add(13), sl.y.wrapping_add(20))) } else { Some((relx.wrapping_add(2), sl.y.wrapping_add(9), relx.wrapping_add(14), sl.y.wrapping_add(21))) };
+      boxes[i] = bb;
+      bg_collision(&mut sl, f.px, f.bounce_cell);
+      // EnemiesCollision (odd FrameCounter; plants excluded on both sides)
+      if f.fc_odd && sl.class != CLASS_PLANT && !sl.masked {
+        if let Some(sb) = bb {
+          for j in (0..i).rev() {
+            let t = self.s[j];
+            if !t.live() || t.class == CLASS_PLANT || t.class == CLASS_LIFT || t.class == CLASS_ITEM || t.class == CLASS_VINE || t.masked { continue; }
+            let tb = match boxes[j] { Some(b) => b, None => continue };
+            if overlap(sb, tb) {
+              if (sl.state | t.state) & 0x80 == 0 {
+                if t.cbits & SETBITS[i] != 0 { continue; }
+                self.s[j].cbits |= SETBITS[i];
+              }
+              if (sl.state | t.state) & 0x20 != 0 { continue; }
+              let (ss, ts) = (sl.state, t.state);
+              if ss < 6 && ts < 6 { turn_around(&mut self.s[j]); turn_around(&mut sl); }
+              else if ss >= 6 && ts < 6 { defeat(&mut self.s[j], f.px); }
+              else if ts >= 6 && ss < 6 { defeat(&mut sl, f.px); }
+              else { defeat(&mut sl, f.px); defeat(&mut self.s[j], f.px); }
+            } else {
+              self.s[j].cbits &= !SETBITS[i];
+            }
+          }
+        }
+      }
+      // PlayerEnemyCollision (even FrameCounter)
+      if !f.fc_odd && player_ok && !sl.masked && sl.state & 0x20 == 0 {
+        if let Some(sb) = bb {
+          if overlap(pbox, sb) {
+            if sl.cbits & 1 == 0 {
+              sl.cbits |= 1;
+              if sl.class == CLASS_PLANT { self.s[i] = sl; return EnemyEvent::Death; }
+              else if sl.class == CLASS_GOOMBA && (sl.state & 7) >= 2 { }
+              else if sl.state & 0x80 != 0 || (sl.state & 7) < 2 {
+                if f.pys_pos || stomp_timer != 0 {
+                  sl.state = 4; sl.itimer = 16; stomp_timer += 1;
+                  s.y_spd = (-4i16 << 8) | (s.y_spd & 0xff);
+                  ev = EnemyEvent::Stomp;
+                } else { self.s[i] = sl; return EnemyEvent::Death; }
+              } else {
+                sl.state |= 0x80;
+                sl.dir = if sl.x as i32 >= f.px { 1 } else { 2 };
+                sl.spd = if sl.dir == 1 { 0x30 } else { 0xd0 };
+                if ev == EnemyEvent::Nothing { ev = EnemyEvent::Kick; }
+              }
+            }
+          } else { sl.cbits &= 0xfe; }
+        }
+      }
+      // EnemyMovementSubs
+      if sl.class == CLASS_PLANT { move_plant(&mut sl, f.fc_odd, f.px); }
+      else {
+        let st = sl.state;
+        if st & 0x40 != 0 { fall_e(&mut sl); }
+        else if st & 0x80 != 0 { steady(&mut sl, 0); }
+        else if st & 0x20 != 0 { gravity(&mut sl); move_h(&mut sl); }
+        else if st & 7 == 0 { steady(&mut sl, 0); }
+        else if st & 7 == 5 { fall_e(&mut sl); }
+        else if st & 7 >= 3 {
+          if sl.itimer != 0 { if sl.class == CLASS_GOOMBA && sl.itimer == 14 { erase(&mut sl); self.s[i] = sl; continue; } }
+          else { sl.state = 0; sl.dir = if f.fc_odd { 2 } else { 1 }; sl.spd = if sl.dir == 1 { 0x08 } else { 0xf8 }; }
+        } else { fall_e(&mut sl); }
+      }
+      if sl.yhi == 2 { erase(&mut sl); self.s[i] = sl; continue; }
+      // OffscreenBoundsCheck
+      if sl.class == CLASS_PLANT {
+        let left = f.sl16 - if (f.sl16 & 0xff) >= 0xc7 { 271 } else { 16 };
+        if (sl.x as i32) < left { erase(&mut sl); self.s[i] = sl; continue; }
+      } else {
+        let left = f.sl16 - 73;
+        let right = sr16 + 72 + if left >= 0 { 1 } else { 0 };
+        if (sl.x as i32) < left || sl.x as i32 >= right { erase(&mut sl); self.s[i] = sl; continue; }
+      }
+      self.s[i] = sl;
+    }
+    // H34: the slot-5 vine (VineObjectHandler, run on slot 5's turn). Order per the asm: (1) grow 1 px upward on
+    // the FrameCounter's d1 frames (2 of every 4) until the global height cap ($30 one vine, $60 once the second
+    // is injected; height = 80 - y); (2) with height >= 8 (RunVSubs' gate), KillVine — erase every vine object
+    // and clear the flag — once the slot-5 vine is moderately offscreen left (Enemy_OffscreenBits & %00001100 =
+    // the X byte's $c0|$80 bits, set from 0/8 px past ScreenLeft).
+    if self.s[5].class == CLASS_VINE {
+      if f.fc_b1 {
+        let height = 80u8.wrapping_sub(self.s[5].y);
+        let cap: u8 = if self.vineflag >= 2 { 0x60 } else { 0x30 };
+        if height < cap { self.s[5].y = self.s[5].y.wrapping_sub(1); }
+      }
+      if 80u8.wrapping_sub(self.s[5].y) >= 8 && (x_offscreen_bits(self.s[5].x as i32, f.sl16) >> 4) & 0x0c != 0 {
+        for i in 0..6 { if self.s[i].class == CLASS_VINE { erase(&mut self.s[i]); } }
+        self.vineflag = 0;
+      }
+    }
+    // the area parser after the enemy loop: a render task on a pipe's left column spawns a piranha plant
+    if let Some(col) = plant_col {
+      for &(pc, pr) in PIPES.iter() {
+        if pc == col {
+          if let Some(free) = (0..5).find(|&i| !self.s[i].live()) {
+            let t = &mut self.s[free];
+            occupy(t, CLASS_PLANT, (pc as u16) * 16 + 8, pr * 16 + 32);
+            t.spd = 1; t.yspd = 0; t.dn = t.y; t.up = t.y.wrapping_sub(24);   // masked/force/collision bits: stale (InitPiranhaPlant does not touch them)
+          }
+          break;
+        }
+      }
+    }
+    ev
+  }
+}
