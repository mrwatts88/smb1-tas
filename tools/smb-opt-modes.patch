+              for dy in -DY_MAX..=DY_MAX { let py = y - dy; if py < 0 || py >= NY { continue; }
+                let pi = b.idx(px, py, pm, c + 1); if b.dist[pi] == INF { b.dist[pi] = level + 1; next.push(pi as u32); } }
+            }
+          }
+        }
+        // pushes land with full credit; the collision happened at the post-move position (x -/+ 1, y)
