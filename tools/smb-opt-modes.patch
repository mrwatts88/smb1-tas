+}
+impl SearchGoal for W42Main {
+  fn new() -> Self { return Self { h: XPosHeuristic::new::<Self>(&<Self as super::SmbSearchCase>::start_states()), goal_gate: None }; }
+  fn distance_to_goal_heuristic(&self, s: &mut State, _: Dist) -> Option<Dist> {
+    Some(self.h.get_steps_until_x_pos_at_least(s, 0x54400))
+  }
+  fn steps_until_x_at_least(&self, s: &mut State, x: i32) -> Option<Dist> { Some(self.h.get_steps_until_x_pos_at_least(s, x)) }
+  fn set_position_goal(&mut self, gx: i32, gy: i32) -> () {
+    let gate = YGate::new::<NTSC>((gy >> 8) - 0x100, surfaces_from_blocks::<BB42>(98));
+    println!("W42Main position goal x >= {} Y <= {}: {}", gx >> 8, (gy >> 8) - 0x100, gate.describe());
+    self.goal_gate = Some((gy, gate));
+  }
+  fn steps_until_xy(&self, s: &mut State, gx: i32, gy: i32) -> Option<Dist> {
+    match self.goal_gate { Some((g, ref gate)) if g == gy => Some(gate.steps_xy(s, &self.h, gx)), _ => Some(self.h.get_steps_until_x_pos_at_least(s, gx)) }
+  }
+  fn is_goal_state(&self, _: &State, emu_result: &EmuResult) -> bool {
+    if let &EmuResult::StateChangeVerticalPipe(cx, cy) = emu_result {
+      cx == 84 && cy == 8
+    } else { false }
+  }
+}
+
+/// 4-2 warp zone: entrance to the world-8 pipe entry (page 3 col 2 row 8 = column 50): X in [804, 812],
+/// x_pos >= 0x32400 (the WR enters at X 810).
+///
+/// Staged bound (P2.3c-2, F83/F89): the pipes sit under the roof (row 2, cols 48..59) whose only way down is the
+/// gap at cols 60..61 (x 960..991) before the right wall; falling through it needs both foot points (x+3, x+12)
+/// over the gap, i.e. X >= 957 = WARP_DROP_X. With ext = 0 (the drop x not yet reached, `--stage` hook) the bound is
+/// max(x-steps to X >= 957 + C_RET, ceil((Y-32)/5) + 22): C_RET = the x-table's minimum over reachable classes at
+/// X 957 moving right of the steps back to X <= 812, and a 96 px descent from the roof level (Y <= 32, needed to
+/// pass over the roof) to the pipe top (Y 128) at <= 4.5 px/frame takes >= 22 frames, the climb <= 5 px/frame.
+/// With ext = 1 the bound is max(x-steps to X <= 812, ceil((128-Y)/4.5)). Without ext (plain bfsc) the phase is
+/// unknown and the weaker ext = 1 form is used.
+pub const WARP_DROP_X: i32 = 957 << 8;
+const WARP_PIPE_XMAX: i32 = (812 << 8) | 0xff;
+const WARP_PIPE_XMIN: i32 = 804 << 8;
+#[allow(dead_code)]
+pub struct W42Warp {
+  h: XPosHeuristic,
+  c_ret: Dist,
+}
+impl W42Warp {
+  /// Minimum steps from any reachable x class at X 957 moving right (x speed >= 1 px/frame: the crossing step) back to X <= 812.
+  fn compute_c_ret(h: &XPosHeuristic) -> Dist {
+    let mut best: Option<Dist> = None;
+    let mut classes = 0;
+    for spd4 in (0x100 / 4)..=(0x2800 / 4) { let spd = spd4 * 4;
+      for &run in &[false, true] {
+        for &st in &[PlayerState::STANDING, PlayerState::JUMPING, PlayerState::FALLING] {
+          for &fd in &[Dir::LEFT, Dir::RIGHT] {
+            let mut s = w42_warp_start::<W42Warp>();
+            s.x_pos = WARP_DROP_X; s.x_spd = spd as i16; s.moving_dir = Dir::RIGHT; s.facing_dir = fd; s.player_state = st; s.running_speed = run;
+            s.set_x_spd_abs::<NTSC>((spd >> 8) as u8);
+            if !h.has_class(&s) { continue; }
+            classes += 1;
+            let d = h.get_steps_until_x_pos_at_most(&s, WARP_PIPE_XMAX);
+            if best.map_or(true, |b| d < b) { best = Some(d); }
+          }
+        }
+      }
+    }
+    println!("W42Warp staged bound: C_RET = {:?} steps (min over {} reachable x classes at X 957 moving right)", best, classes);
+    best.unwrap_or(0)
+  }
+  fn y_part(s: &State, staged: bool) -> Dist {
+    let y = s.y_pos >> 8; // 0x100 = Y 0 (y_pos 0x10000 = Y 0)
+    if staged {
+      let up = if y > 0x120 { ((y - 0x120) + 4) / 5 } else { 0 }; // climb to Y <= 32 at <= 5 px/frame
+      (up + 22) as Dist
+    } else if y < 0x180 { (((0x180 - y) * 2 + 8) / 9) as Dist } else { 0 } // descent to Y 128 at <= 4.5 px/frame
+  }
+}
+impl Options for W42Warp {
+  type CoinHandler = W42WarpCoins;
+  type Platform = NTSC;
+  type PlayerSize = Small;
+  type Swim = NotSwimming;
+  type PowerupHandler = NoPowerups;
+  type RunningTimer = WithRunningTimer;
+  type ScrollPos = NoScrollPos;
+  type Parity = NoParity;
+  type VerticalPipeHandler = EnterVerticalPipe<::typenum::U50, ::typenum::U8>;
+  type YPosFractionalBehavior = KeepYPosFractionals;
+  type BlockBounce = WithBlockBounceTimer;
+  type BlockStates = NoBlockStates;
+}
+impl super::SmbSearchCase for W42Warp {
+  type SearchGoal = Self;
+  type StateStore = ::store::VecHashMap<CompressedState<Self, [u8; 14]>, Dist>;
+
+  type BlockBuffer = BB42Warp;
+
+  fn start_states() -> Vec<State> {
+    vec![w42_warp_start::<Self>()]
+  }
+  const SEARCH_SPACE_SIZE_HINT: usize = 1000000;
+}
+impl SearchGoal for W42Warp {
+  fn new() -> Self {
+    let mut h = XPosHeuristic::new::<Self>(&<Self as super::SmbSearchCase>::start_states());
+    let c_ret = Self::compute_c_ret(&h);
+    h.build_overshoot_bound(WARP_DROP_X, WARP_PIPE_XMAX, 96);
+    Self { h, c_ret }
+  }
+  /// Phase unknown: the ext = 1 form (sound in both phases; before the drop it is weaker than the x-only bound only
+  /// when X > 812, where steps-to-X>=804 is 0 anyway).
+  fn distance_to_goal_heuristic(&self, s: &mut State, _: Dist) -> Option<Dist> {
+    let hx = if s.x_pos < WARP_PIPE_XMIN { self.h.get_steps_until_x_pos_at_least(s, WARP_PIPE_XMIN) } else { self.h.get_steps_until_x_pos_at_most(s, WARP_PIPE_XMAX) };
+    Some(::std::cmp::max(hx, Self::y_part(s, false)))
+  }
+  fn distance_to_goal_heuristic_ext(&self, s: &mut State, ext: u16, _: Dist) -> Option<Dist> {
+    if ext == 0 {
+      let hx_dec = self.h.get_steps_until_x_pos_at_least(s, WARP_DROP_X) + self.c_ret; // decoupled (approach + best return)
+      let hx_cpl = self.h.get_steps_overshoot(s, WARP_DROP_X); // coupled: approach ending in class a + R(a)
+      let hx = ::std::cmp::max(hx_dec, hx_cpl);
+      Some(::std::cmp::max(hx, Self::y_part(s, true)))
+    } else {
+      let hx = self.h.get_steps_until_x_pos_at_most(s, WARP_PIPE_XMAX);
+      Some(::std::cmp::max(hx, Self::y_part(s, false)))
+    }
+  }
+  fn is_goal_state(&self, _: &State, emu_result: &EmuResult) -> bool {
+    if let &EmuResult::StateChangeVerticalPipe(cx, cy) = emu_result {
+      cx == 50 && cy == 8
+    } else { false }
+  }
+}
