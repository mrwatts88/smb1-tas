 fn main() {
+  let args: Vec<String> = ::std::env::args().collect();
+  if args.len() >= 6 && args[1] == "bfs11" {
+    // bfs11 INPUTS.bin FIRST_RECORD PREFIX_STEPS MAX_STEPS [STEP:yspd=V]... [--root-frame F] [--any-y] [--out FILE]
+    // Replays PREFIX_STEPS NES-order input records (from FIRST_RECORD) through the 1-1 third-room model
+    // (w11_pipe_start, optional y-speed overrides as in trace11pipe), then runs a layered BFS of at most
+    // MAX_STEPS steps over the 16 A/B/L/R inputs with global dedup on the compressed 10-byte player state
+    // (the model has no frame counter, so a state seen earlier dominates the same state seen later) and
+    // MrWint's Bounds heuristic (x >= 0xc5600 i.e. X >= 3158 and, unless --any-y, y >= 0x1a200 i.e.
+    // Y >= 162 = the flagpole glitch) as the deadline bound. Every flagpole grab (EmuResult::StateChangeFlag)
+    // is recorded with its step, x, y. Memory: ~10 B key + ~5 B parent/input per visited state, plus the
+    // full states of the current and next layer only.
