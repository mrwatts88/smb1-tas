+//! P2.3c-5 (2026-08-24): the scroll-aware "drift" bound for the 4-2 wrong-warp finale — W42Main's case goal under
+//! the F40 refusal (`bfscx --enemies`, main.rs `w42_enemies`: states with ScreenLeft16 >= 1217 are pruned).
+//!
+//! The wrong warp needs ScreenLeft <= 1216 at the pipe entry (X in [1348, 1356]), i.e. a scroll offset
+//! rel = X - ScreenLeft >= 132 = 0x70 + 20 (F40, F120). In the model (emu.rs) rel changes per frame only by
+//!   * this frame's integer movement dx when it is NOT scrolled (scroll_handler_inner, F77): always while rel < 0x50;
+//!     dx - 1 for dx >= 2 while 0x50 <= rel < 0x70; never once rel >= 0x70 (exact tracking) -- EXCEPT while
+//!     side_collision_timer > 0: the <= 15 frames after a side collision, during which nothing scrolls. A side
+//!     collision keeps only the speed's fraction (impede_player_move: x_spd &= 0xff), so those 15 frames move
+//!     Mario by at most G(15) px (the x table's max displacement from a |speed| < 1/16 px/frame class), less than
+//!     1 px per frame (0xff + 14 * FRICTION_RUN < 0x1000);
+//!   * a collision push (impede_player_move, never scrolled): +1 px when moving_dir != RIGHT and x_spd < 0x100,
+//!     -1 px when moving right -- only when a collision point is inside a non-empty block-buffer cell: the feet
+//!     (X+3 / X+12, Player_Y + 32) at depth (Y & 0xf) >= 5 (BLOCK_SURFACE_THICKNESS), or a side point
+//!     (X+2 / X+13, Y + 24) with Y >= 8 -- the push SITES, read from the case's block buffer.
+//! The refusal makes X <= 1216 + rel = 1328 + m (m = rel - 0x70) a wall every surviving state respects.
+//!
+//! Relaxation (a graph whose BFS distance to X >= 1348 is the bound): state (X px, Y = Player_Y, m, credit c);
+//! per step either a move |dx| <= 3, |dy| <= 5 gaining any offset from min(dx, 0) up to the regime's maximum
+//! (losing offset when moving left is optional -- a superset), a credit move (+1 px unscrolled, c -= 1), a push at a
+//! site (+1 px / +1 m, optionally with a 1-px carry; or -1 / -1 after a move; both reset c = C), always inside the
+//! wall. Every model transition of a surviving state maps to one relaxed transition (the domain edges are handled
+//! by clamping with permissive gain ranges, Y < 0 / Y > 191 / X < X0 collapse onto the edge, X < X0 answers 0),
+//! and the query uses the full credit C (distance is monotone in c), so h is admissible. Audit: tools/drift_audit.py
+//! (consistency h(s) <= h(s') + 1 along random trajectories under the hook, h = 0 at goals).
+use blockbuffer::BlockBuffer;
+use emu::screen_left_abs;
+use heuristics::xpos::XPosHeuristic;
+use options::{Platform, NTSC};
+use state::{Dist, State};
+
+pub const GOAL_X: i32 = 1348;      // px: the case goal's x_pos >= 0x54400
+pub const SL_MAX: i32 = 1216;      // the F40 refusal: ScreenLeft16 >= 1217 is route-dead
+pub const REL_TRACK: i32 = 0x70;   // ScrollHandler: exact tracking from this relative x
+pub const REL_SCROLL_MIN: i32 = 0x50; // below this relative x nothing scrolls
+const WALL: i32 = SL_MAX + REL_TRACK; // 1328: X <= WALL + m for every surviving state
+const X0: i32 = 1180;
+const X1: i32 = 1360;
+const NY: i32 = 192;
+const M_LO: i32 = -40;
+const M_HI: i32 = 24;
+const DX_MAX: i32 = 3;
+const DY_MAX: i32 = 5;
+const FOOT_DEPTH: i32 = 5;
+const TIMER_FRAMES: usize = 15;
+const INF: u8 = 255;
+
+pub struct DriftBound {
+  cmax: i32,
+  nm: usize,
+  nc: usize,
+  dist: Vec<u8>,
+  sites: Vec<bool>,
+  pub note: String,
+}
+
+fn clamp(v: i32, lo: i32, hi: i32) -> i32 { if v < lo { lo } else if v > hi { hi } else { v } }
+/// Max offset gain of an unpushed move of dx px from offset pm (m units): the scroll regimes of scroll_handler_inner.
+fn gain_max(dx: i32, pm: i32) -> i32 {
+  if dx <= 0 { 0 }
+  else if pm + REL_TRACK < REL_SCROLL_MIN { dx }
+  else if pm < 0 { if dx >= 2 { 1 } else { 0 } }
+  else { 0 }
+}
+/// Push site: some collision point of Mario at (X, Player_Y) is inside a non-empty cell (any cell value counts: a
+/// superset of the impeding ones).
+fn site_at<B: BlockBuffer>(x: i32, y: i32) -> bool {
+  if x < 0 || y < 0 || y >= NY { return false; }
+  let solid = |cx: i32, cy: i32| -> bool { cx >= 0 && B::get_block_at(cx as usize, (cy & 0xf) as usize) != 0 };
+  if (y & 0xf) >= FOOT_DEPTH {
+    let row = y >> 4; // feet at Player_Y + 32: row ((y_pos + 0x2000 - 0x2000) >> 12) & 0xf
+    if solid((x + 3) >> 4, row) || solid((x + 12) >> 4, row) { return true; }
+  }
+  if y >= 8 {
+    let row = (y + 248) >> 4; // side points at Player_Y + 24: row ((y_pos + 0x1800 - 0x2000) >> 12) & 0xf
+    if solid((x + 2) >> 4, row) || solid((x + 13) >> 4, row) { return true; }
+  }
+  false
+}
+/// Offset-change range of a relaxed transition kind: 0 = plain move dx=p, 1 = credit move of p px, 2 = push right
+/// with carry p in {0,1}, 3 = push left after a move of p px.
+fn delta_range(kind: u8, p: i32, pm: i32) -> (i32, i32) {
+  match kind {
+    0 => (::std::cmp::min(p, 0), gain_max(p, pm)),
+    1 => (p, p),
+    2 => (1, 1 + p),
+    _ => (-1, -1 + ::std::cmp::max(gain_max(p, pm), ::std::cmp::min(p, 1))),
+  }
+}
+/// Predecessor offsets pm whose transition (kind, p) can land on offset m (with clamping to [M_LO, M_HI]).
+fn pm_list(m: i32, kind: u8, p: i32) -> Vec<i8> {
+  let mut v = Vec::new();
+  for pm in M_LO..=M_HI {
+    let (lo, hi) = delta_range(kind, p, pm);
+    let mut ok = false;
+    let mut d = lo;
+    while d <= hi { if clamp(pm + d, M_LO, M_HI) == m { ok = true; break; } d += 1; }
+    if ok { v.push(pm as i8); }
+  }
+  v
+}
+
+impl DriftBound {
+  pub fn new<B: BlockBuffer>(xt: &XPosHeuristic) -> DriftBound {
+    let t0 = ::std::time::Instant::now();
+    // the credit: max movement in the <= 15 unscrolled frames after a side collision (speed fraction only), plus one
+    // integer-crossing slop; per frame < 1 px (checked against the platform's acceleration).
+    assert!(0xff + (TIMER_FRAMES as i32 - 1) * (<NTSC as Platform>::FRICTION_RUN as i32) < 0x1000, "timer-window speed reaches 1 px/frame: the credit move needs dx > 1");
+    let mut gains: Vec<i32> = Vec::new();
+    let mut best = 0i32;
+    for k in 1..=TIMER_FRAMES { let g = xt.max_gain_below_speed(0x100, k); gains.push(g); if g > best { best = g; } }
+    let cmax = best / 256 + 1;
+    let nm = (M_HI - M_LO + 1) as usize;
+    let nc = (cmax + 1) as usize;
+    // push sites over the domain; the edge column X0 also carries every site left of it (states left of X0 collapse onto it)
+    let nx = (X1 - X0 + 1) as usize;
+    let mut sites = vec![false; nx * NY as usize];
+    for x in X0..=X1 { for y in 0..NY { sites[((x - X0) as usize) * NY as usize + y as usize] = site_at::<B>(x, y); } }
+    for x in 0..X0 { for y in 0..NY { if site_at::<B>(x, y) { sites[y as usize] = true; } } }
+    let nsites = sites.iter().filter(|&&b| b).count();
+    // transition tables: predecessor offsets per (kind, p, m)
+    let tab = |kind: u8, p: i32| -> Vec<Vec<i8>> { (M_LO..=M_HI).map(|m| pm_list(m, kind, p)).collect() };
+    let t_plain: Vec<Vec<Vec<i8>>> = (-DX_MAX..=DX_MAX).map(|dx| tab(0, dx)).collect();
+    let t_credit: Vec<Vec<i8>> = tab(1, 1);
+    let t_pushr: Vec<Vec<Vec<i8>>> = (0..=1).map(|k| tab(2, k)).collect();
+    let t_pushl: Vec<Vec<Vec<i8>>> = (0..=DX_MAX).map(|dx| tab(3, dx)).collect();
+    let mut b = DriftBound { cmax, nm, nc, dist: vec![INF; nx * NY as usize * nm * nc], sites, note: String::new() };
+    // BFS from the goal set over predecessors
+    let mut frontier: Vec<u32> = Vec::new();
+    for x in GOAL_X..=X1 { for y in 0..NY { for m in M_LO..=M_HI { if x > WALL + m { continue; } for c in 0..=cmax { let i = b.idx(x, y, m, c); b.dist[i] = 0; frontier.push(i as u32); } } } }
+    let mut level: u8 = 0;
+    let mut reached = frontier.len();
+    let site = |b: &DriftBound, x: i32, y: i32| -> bool { x >= X0 && x <= X1 && y >= 0 && y < NY && b.sites[((x - X0) as usize) * NY as usize + y as usize] };
+    while !frontier.is_empty() && level < INF - 2 {
+      let mut next: Vec<u32> = Vec::new();
+      for &ti in &frontier {
+        let (x, y, m, c) = b.decode(ti as usize);
+        // plain moves (credit unchanged)
