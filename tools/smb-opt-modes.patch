new file mode 100644
index 0000000..82bccbb
--- /dev/null
+++ b/src/heuristics/ygate.rs
@@ -0,0 +1,234 @@
+//! P2.3c-2c — a sound y-coupled lower bound ("y gate") for position goals `x_pos >= gx && Player_Y <= gy`.
+//!
+//! Relaxation (a superset of the model's vertical behaviour, x handled only through MrWint's x table):
+//! * vertical dynamics exactly as in `emu.rs`: a jump starts at JUMP_VELOCITY_FAST/SLOW with the jump gravity
+//!   `v_force` (kept only while A is held and y_spd < 0; releasing is irreversible), `y_pos += y_spd; y_spd +=
+//!   v_force` with the MAX_Y_SPD clamp, a head bump sets `y_spd = 0x100 | frac` (allowed here on ANY frame with
+//!   y_spd < 0 — the model also needs Y mod 16 >= 4 and a block, so this is a superset), a landing needs
+//!   `y_spd >= 0` and `Y in [Ys, Ys + 5)` (BLOCK_SURFACE_THICKNESS) on a standable cell top and snaps Y to Ys;
+//! * the surfaces are EVERY standable cell top of the block buffer (solid, pipe, brick, question, hidden — a
+//!   one-frame landing inside a wall face is the SMB1 wall jump, and the floor-level wall walk (F80) makes cell
+//!   rows inside a solid run standable too), each with the x_pos interval in which one of Mario's foot points
+//!   (x+3, x+12) is inside the cell's column; a landing on a surface is charged max(vertical arrival lower
+//!   bound, x-table steps to bring x into one of its intervals);
+//! * T(Ys) = the y-only minimum steps from standing at Ys to Y <= gy over jump / landing chains (surfaces above
+//!   only — landing lower never helps in the y-only relaxation, see the monotonicity note), precomputed top-down.
+//! Per state the bound is the first step k at which BOTH `x_pos >= gx` is x-feasible (x table: max gain in k
+//! steps >= gx - x) AND `Y <= gy` is y-feasible: k inside the hold-A trajectory's window of Y <= gy (the hold-A
+//! trajectory is pointwise the highest one — every release or bump only lowers it) or k >= the earliest
+//! (landing + T) over all surfaces. Standing states may wait, so their y-feasibility is "k >= t".
+//!
+//! Monotonicity note (y-only): from a higher surface every chain of a lower one can be shadowed step by step
+//! (same jumps, each milestone reached no later), so T is non-decreasing in Ys and a chain that lands at or below
+//! its own start is never faster than the best chain that does not. The x-aware per-state query does NOT use that
+//! shortcut: every surface (above or below the state) is considered with its own x charge.
+use blockbuffer::BlockBuffer;
+use blockbuffer::util::{is_climb, is_coin};
+use heuristics::xpos::XPosHeuristic;
+use options::Platform;
+use state::{Dist, PlayerState, State};
+
+pub const Y_NEVER: Dist = 0x7ff0;
+const HORIZON: usize = 96;
+const SCAN_MAX: usize = 4000;
+
+/// A standable cell top: Mario standing on it has pixel Y `y`; `xs` = merged inclusive x_pos intervals in which
+/// one of his foot points is inside a cell of that row.
+#[derive(Clone, Debug)]
+pub struct Surface { pub y: i32, pub xs: Vec<(i32, i32)> }
+
+#[derive(Clone, Copy, Debug)]
+struct Air { y: i32, v: i16, g: u8, gd: u8 }
+
+pub struct YGate {
+  y_max: i32,                 // pixel Y
+  surf: Vec<Surface>,         // ascending y (highest first)
+  t_surf: Vec<Dist>,          // y-only T(surface)
+  max_y_spd: i16,
+  jumps: [(i16, u8, u8); 3],  // (y_spd0, jump gravity, fall gravity): running, walking, standing
+  fall_g: u8,                 // the largest fall gravity (fastest walk-off descent)
+}
+
+#[inline] fn px(y_pos: i32) -> i32 { (y_pos >> 8) - 0x100 }
+#[inline] fn dmin(a: Dist, b: Dist) -> Dist { if a < b { a } else { b } }
+#[inline] fn dmax(a: Dist, b: Dist) -> Dist { if a > b { a } else { b } }
+
+/// Every standable cell top of a block buffer of `width` columns (cells != 0 that are not coins or climbables;
+/// hidden blocks are included — bumped they become platforms), merged into per-Y x intervals.
+pub fn surfaces_from_blocks<B: BlockBuffer>(width: usize) -> Vec<Surface> {
+  let mut by_y: ::std::collections::BTreeMap<i32, Vec<(i32, i32)>> = ::std::collections::BTreeMap::new();
+  for c in 0..width { for r in 0..13 {
+    let cv = B::get_block_at(c, r);
+    if cv == 0 || is_coin(cv) || is_climb(cv) { continue; }
+    let lo = ((16 * c as i32) - 12) << 8; let hi = (((16 * c as i32) + 12) << 8) | 0xff;
+    by_y.entry(16 * r as i32).or_insert_with(Vec::new).push((if lo < 0 { 0 } else { lo }, hi));
+  } }
+  let mut out = Vec::new();
+  for (y, mut xs) in by_y {
+    xs.sort();
+    let mut merged: Vec<(i32, i32)> = Vec::new();
+    for (lo, hi) in xs {
+      if let Some(last) = merged.last_mut() { if lo <= last.1 + 1 { if hi > last.1 { last.1 = hi; } continue; } }
+      merged.push((lo, hi));
+    }
+    out.push(Surface { y, xs: merged });
+  }
+  out
+}
+
+impl YGate {
+  pub fn new<P: Platform>(y_max: i32, surf: Vec<Surface>) -> YGate {
+    let mut g = YGate { y_max, surf, t_surf: Vec::new(), max_y_spd: P::MAX_Y_SPD,
+      jumps: [(P::JUMP_VELOCITY_FAST, P::V_FORCE_JUMP_RUNNING, P::V_FORCE_FALL_RUNNING),
+              (P::JUMP_VELOCITY_SLOW, P::V_FORCE_JUMP_WALKING, P::V_FORCE_FALL_WALKING),
+              (P::JUMP_VELOCITY_SLOW, P::V_FORCE_JUMP_STANDING, P::V_FORCE_FALL_STANDING)],
+      fall_g: P::V_FORCE_FALL_RUNNING };
+    for i in 0..g.surf.len() { let t = g.t_ground_yonly(g.surf[i].y, i); g.t_surf.push(t); }
+    g
+  }
+  pub fn describe(&self) -> String {
+    let mut s = format!("y gate: Y <= {}; {} surface rows:", self.y_max, self.surf.len());
+    for (i, sf) in self.surf.iter().enumerate() {
+      s.push_str(&format!(" Y{}:T={}", sf.y, if self.t_surf[i] >= Y_NEVER { "never".to_string() } else { self.t_surf[i].to_string() }));
+      s.push_str(&format!("[{}]", sf.xs.iter().map(|&(lo, hi)| format!("{}..{}", lo >> 8, hi >> 8)).collect::<Vec<_>>().join(",")));
+    }
+    s
+  }
+  /// One frame of vertical movement (PlayerMovementSubs JUMPING/FALLING + MoveVertically), `hold` = A held.
+  #[inline] fn mv(&self, a: &mut Air, hold: bool) {
+    let keep = hold && a.v < 0;
+    if !keep { a.g = a.gd; }
+    a.y += a.v as i32;
+    a.v += a.g as i16;
+    if a.v >= self.max_y_spd && (a.v & 0xff) >= 0x80 { a.v = self.max_y_spd; }
+  }
+  /// The hold-A trajectory from `a0` (frame 1 = the first step): (first k with Y <= y_max, last such k, and per
+  /// surface index < n_above the first k with Y <= Ys + 4 — the earliest frame a landing on it can happen).
+  /// `off` is added to every k (a jump's first frame already taken).
+  fn hold_terms(&self, a0: Air, n_above: usize, off: Dist, k1: &mut [Dist]) -> (Dist, Dist) {
+    let mut a = a0;
+    let (mut kd, mut kde) = (Y_NEVER, Y_NEVER);
+    let mut idx = n_above; // surfaces ascending by y: indices < n_above are above the start; scan from the lowest of them upward
+    for k in 1..=HORIZON {
+      self.mv(&mut a, true);
+      let y = px(a.y);
+      if y <= self.y_max { if kd == Y_NEVER { kd = k as Dist + off; } kde = k as Dist + off; }
+      while idx > 0 && self.surf[idx - 1].y + 4 >= y { idx -= 1; k1[idx] = dmin(k1[idx], k as Dist + off); }
+      if a.v >= 0 && y > self.y_max { break; }
+    }
+    if kd != Y_NEVER && kde == (HORIZON as Dist + off) { kde = Y_NEVER; } // window still open at the horizon: leave it open (weaker, sound)
+    (kd, kde)
+  }
+  /// Fastest descents from `a0`: per surface index >= i_from (surfaces at or below the start), the first k with
+  /// Y_k >= Ys (the landing window [Ys, Ys+5) cannot be skipped at <= 4.5 px/frame), over the policies
+  /// bump-at-frame-1 (hold or released gravity for the fraction) and release-only; `off` added to every k.
+  fn descent_terms(&self, a0: Air, i_from: usize, off: Dist, land: &mut [Dist]) {
+    for policy in 0..3 {
+      let mut a = a0;
+      let mut idx = i_from;
+      let n = self.surf.len();
+      for k in 1..=HORIZON {
+        if k == 1 {
+          self.mv(&mut a, policy == 0);
+          if policy < 2 && a.v < 0 { a.v = 0x100 | (a.v & 0xff); a.g = a.gd; }
+        } else { self.mv(&mut a, false); }
+        if a.v >= 0 {
+          let y = px(a.y);
+          while idx < n && self.surf[idx].y <= y { land[idx] = dmin(land[idx], k as Dist + off); idx += 1; }
+          if idx >= n { break; }
+        }
+      }
+    }
+  }
+  /// y-only T(Ys): min steps from standing at pixel Y `y` to Y <= y_max using only surfaces with index < n_above.
+  fn t_ground_yonly(&self, y: i32, n_above: usize) -> Dist {
+    if y <= self.y_max { return 0; }
+    let mut best = Y_NEVER;
+    let mut k1 = vec![Y_NEVER; self.surf.len()];
+    for &(v0, gj, gd) in &self.jumps {
+      let mut a = Air { y: (y + 0x100) << 8, v: v0, g: gj, gd };
+      a.y += a.v as i32; a.v += gj as i16; // the jump's first frame (fraction cleared, then the move)
+      for v in k1.iter_mut() { *v = Y_NEVER; }
+      let (kd, _) = self.hold_terms(a, n_above, 1, &mut k1);
+      best = dmin(best, kd);
+      for i in 0..n_above { if k1[i] != Y_NEVER && self.t_surf[i] != Y_NEVER { best = dmin(best, k1[i] + self.t_surf[i]); } }
+    }
+    best
+  }
+  /// Steps to bring x_pos into one of the surface's intervals (0 if inside one), by the x table.
+  fn x_part(&self, s: &State, h: &XPosHeuristic, sf: &Surface) -> Dist {
+    let mut best = Y_NEVER;
+    for &(lo, hi) in &sf.xs {
+      let d = if s.x_pos < lo { h.get_steps_until_x_pos_at_least(s, lo) } else if s.x_pos > hi { h.get_steps_until_x_pos_at_most(s, hi) } else { 0 };
+      best = dmin(best, d);
+    }
+    best
+  }
+  /// y-feasibility structure of a state: (kd, kde, tr) — Y <= y_max is possible at step k iff kd <= k <= kde or
+  /// k >= tr (tr = earliest landing + T over all surfaces, with the x charge; standing states may wait, so for
+  /// them kde = infinity).
+  pub fn terms(&self, s: &State, h: &XPosHeuristic) -> (Dist, Dist, Dist) {
+    let y = px(s.y_pos);
+    if s.player_state == PlayerState::CLIMBING { return (0, Y_NEVER, 0); }
+    let n = self.surf.len();
+    let n_above = self.surf.iter().position(|sf| sf.y >= y).unwrap_or(n); // surfaces with Ys < y
+    let mut k1 = vec![Y_NEVER; n];
+    let mut land = vec![Y_NEVER; n];
+    let (mut kd, mut kde) = (Y_NEVER, Y_NEVER);
+    if s.player_state == PlayerState::STANDING {
+      if y <= self.y_max { return (0, Y_NEVER, 0); }
+      for &(v0, gj, gd) in &self.jumps {
+        let mut a = Air { y: (y + 0x100) << 8, v: v0, g: gj, gd };
+        a.y += a.v as i32; a.v += gj as i16;
+        let (d, _) = self.hold_terms(a, n_above, 1, &mut k1);
+        kd = dmin(kd, d);
+      }
+      kde = if kd == Y_NEVER { Y_NEVER } else { Y_NEVER }; // may wait on the ground: open-ended
+      // walk-off descent (FALLING with y_spd 0 at the fastest fall gravity) onto lower surfaces
+      let a = Air { y: s.y_pos, v: 0, g: self.fall_g, gd: self.fall_g };
+      let i_from = self.surf.iter().position(|sf| sf.y > y).unwrap_or(n);
+      self.descent_terms(a, i_from, 0, &mut land);
+    } else {
+      if y <= self.y_max {
+        // still up: the window starts now (k = 0 is the current state; the search asks about future steps)
+        kd = 0;
+      }
+      let a = Air { y: s.y_pos, v: s.y_spd, g: s.v_force, gd: s.v_force_down };
+      let (d, de) = self.hold_terms(a, n_above, 0, &mut k1);
+      if kd == 0 { kde = if d == 1 { de } else { 0 }; } else { kd = d; kde = de; }
+      self.descent_terms(a, n_above, 0, &mut land);
+    }
+    let mut tr = Y_NEVER;
+    for i in 0..n {
+      let t = self.t_surf[i];
+      if t == Y_NEVER { continue; }
+      let jy = dmin(k1[i], land[i]);
+      if jy == Y_NEVER { continue; }
+      if self.surf[i].y == y && s.player_state == PlayerState::STANDING { continue; }
+      let jx = self.x_part(s, h, &self.surf[i]);
+      if jx == Y_NEVER { continue; }
+      let j = dmax(jy, jx);
+      if j + t < tr { tr = j + t; }
+    }
+    (kd, kde, tr)
+  }
+  /// The joint bound: first k >= 1 with x-feasible(k) (x table) and y-feasible(k); Y_NEVER if none.
+  pub fn steps_xy(&self, s: &State, h: &XPosHeuristic, gx: i32) -> Dist {
+    let dx = gx - s.x_pos;
+    let tables = match h.class_tables(s) { Some(t) => t, None => return 0 }; // unknown class: never prune
+    let (maxd, mxd) = tables;
+    let gain = |k: usize| -> i32 { let len = maxd.len(); if k == 0 { 0 } else if len == 0 { mxd * k as i32 } else if len >= k { maxd[k - 1] } else { maxd[len - 1] + mxd * (k - len) as i32 } };
+    let (kd, kde, tr) = self.terms(s, h);
+    let ystart = dmin(kd, tr);
+    if ystart == Y_NEVER { return Y_NEVER; }
+    let mut k = if ystart == 0 { 1 } else { ystart as usize };
+    while k < SCAN_MAX {
+      let kk = k as Dist;
+      let yok = (kk >= kd && kk <= kde) || kk >= tr;
+      if yok && (dx <= 0 || gain(k) >= dx) { return kk; }
+      if !yok && kk > kde && kk < tr { k = tr as usize; continue; }
+      k += 1;
+    }
+    Y_NEVER
+  }
+}
