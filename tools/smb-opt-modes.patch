+  let goal = Arc::new(goal0);
+  let hval = |g: &C::SearchGoal, st: &State, e: &Ext, step: usize| -> Option<usize> { xy_h(g, st, e.u16(), step, goal_x, goal_y) };
+  if let Some(gx) = goal_x { println!("position goal: x_pos >= {:#x} (X {}){}; bound = x table to that x, y-coupled (ygate) when the case supports --goal-y", gx, gx >> 8, match goal_y { Some(gy) => format!(", y_pos <= {:#x} (Y <= {})", gy, (gy >> 8) - 0x100), None => String::new() }); assert!(hval(&goal, &s, &e0, 0).is_some(), "this case has no x-only table for --goal-x"); }
+  println!("heuristic built in {:.1}s; at root: {:?} steps (deadline {} steps)", (time::precise_time_ns() - t0) as f64 / 1e9, hval(&goal, &s, &e0, 0), max_steps);
+  // reference path (--check-path): (state, ext, record) per step
+  let mut refpath: Vec<(State, Ext, XRec)> = Vec::new();
+  if check_path > 0 {
+    let (mut rs, mut re) = (s.clone(), e0);
+    let mut hmax_viol = 0usize;
+    for k in 0..check_path {
+      let input = nes_to_model(data[first + prefix + k]);
+      let (mut ns, res) = <C as case::SmbSearchCase>::Emu::run_step(rs.clone(), input);
+      let g = xy_goal(&*goal, &ns, &res, goal_x, goal_y);
+      if let Some(h) = hook { if res == EmuResult::Success { let ev = h(&rs, &mut ns, &mut re); if ev != LiftEvent::Nothing { println!("reference path: step {} object event {:?} ext {:x}", k + 1, ev, re); } } }
+      let hv = hval(&goal, &ns, &re, k + 1);
+      // admissibility check against the reference path itself: h(state after step k+1) must not exceed the steps the reference still needs
+      if let Some(hh) = hv { if k + 1 + hh > check_path { hmax_viol += 1; println!("reference path: step {} BOUND VIOLATION h {} > {} remaining", k + 1, hh, check_path - (k + 1)); } }
+      println!("reference path: step {} x {:#x} y {:#x} xspd {:#x} yspd {:#x} {:?} ext {:x} h {:?} result {:?}{}", k + 1, ns.x_pos, ns.y_pos, ns.x_spd, ns.y_spd, ns.player_state, re, hv, res, if g { " GOAL" } else { "" });
+      if g || res != EmuResult::Success { println!("reference path: {} bound violations over {} steps (reference length {})", hmax_viol, k + 1, check_path); }
+      if res != EmuResult::Success { break; }
+      let rec = mk_rec(&Key::<C, A>::from_state(&ns), &re);
+      refpath.push((ns.clone(), re, rec));
+      rs = ns;
+    }
+  }
+  let inputs: Vec<u8> = (0..16u8).map(|k| { let mut v = 0u8; if k & 1 != 0 { v |= 0x80; } if k & 2 != 0 { v |= 0x40; } if k & 4 != 0 { v |= 0x02; } if k & 8 != 0 { v |= 0x01; } v }).collect();
+  let mut step = 0usize;
+  match resume {
+    Some(r) => {
+      let md = ::std::fs::metadata(layer_path(r)).expect("--resume: layer file missing (decompress the .xz first)");
