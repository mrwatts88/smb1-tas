+  /// DestroyBlockMetatile into VRAM_Buffer1, and decides Block_Metatile for the restore: $c4 for question/hidden/
+  /// item bricks; coin bricks $58/$5d stay coin bricks while BrickCoinTimer runs (first bump: flag set, timer 11)
+  /// and become $c4 once the flag is set and the timer has expired; plain bricks come back as themselves.
+  fn fresh_bump(&mut self, cx: usize, cy: usize) -> () {
+    self.vbuf1_busy = true;
+    if self.s.blocks.bounce_cell != 0 { self.s.blocks.bounce_cell = 0; } // a second block slot would be used; its restore (still pending here) is approximated as done (see docs/experiments/P2.3b-2-block-states.md)
+    self.s.blocks.bounce_cell = block_cell_id(cx, cy);
