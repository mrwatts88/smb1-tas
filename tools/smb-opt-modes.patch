+/// g bits: 0/1 = goomba 0/1 stomped (state 4, harmless), 2/3 = its Enemy_CollisionBits d0.
+/// Assumptions: a goomba that overlaps Mario is on screen (no offscreen-bit masking) and boxes do not wrap.
+fn room_enemies(f: i64, s: &mut State, g: &mut u8) -> RoomEvent {
+  if f % 2 == 0 { return RoomEvent::Nothing; }                       // FrameCounter = f - 925 (harness dump) must be even: odd model frames only
+  if (s.y_pos >> 16) != 1 || ((s.y_pos >> 8) & 0xff) >= 0xd0 { return RoomEvent::Nothing; } // CheckPlayerVertical
+  let px = s.x_pos >> 8;
+  let py = (s.y_pos >> 8) & 0xff;
+  let (pl, pr, pt, pb) = (px + 3, px + 13, py + 20, py + 32);        // BoundBoxCtrlData[1], small Mario
+  let mut stomp_timer = 0u8;                                          // frame timer, 0 at frame start
+  let mut ev = RoomEvent::Nothing;
+  for i in 0..2usize {
+    if *g & (1 << i) != 0 { continue; }
+    let gx = goomba_x(i, f - 1);                                      // the enemy moves after the collision check
+    let (gl, gr, gt, gb) = (gx + 3, gx + 13, GOOMBA_Y + 14, GOOMBA_Y + 20); // BoundBoxCtrlData[9]
+    let overlap = pl <= gr && gl <= pr && pt <= gb && gt <= pb;       // CollisionCoreLoop, inclusive edges
+    if !overlap { *g &= !(4 << i); continue; }
+    if *g & (4 << i) != 0 { continue; }                               // d0 already set: HandlePECollisions leaves
+    *g |= 4 << i;
+    if (s.y_spd >> 8) > 0 || stomp_timer != 0 {                       // moving down, or StompTimer set this frame
+      *g |= 1 << i;
+      stomp_timer += 1;
+      s.y_spd = (-4i16 << 8) | (s.y_spd & 0xff);                      // HandleStompedShellE: Player_Y_Speed = $fc
+      ev = RoomEvent::Stomp(i as u8);
+    } else {
+      return RoomEvent::Death;                                        // small Mario: KillPlayer
+    }
+  }
+  ev
+}
+
+fn nes_to_model(b: u8) -> emu::Input { let mut v = 0u8; for bit in 0..8 { if b & (1 << bit) != 0 { v |= 0x80 >> bit; } } emu::Input::from_bits_truncate(v) }
+fn model_to_nes(v: u8) -> u8 { let mut b = 0u8; for bit in 0..8 { if v & (1 << bit) != 0 { b |= 0x80 >> bit; } } b }
+
+/// Replays `prefix` NES-order records (data[first..]) from w11_pipe_start; returns (state, goomba bits, alive).
+fn replay11<C: case::SmbSearchCase>(data: &[u8], first: usize, prefix: usize, overrides: &[(usize, i16)], goombas: bool, trace: bool) -> (State, u8, bool) { replay11b::<C>(data, first, prefix, overrides, goombas, trace, None) }
+/// replay11 with an optional x-heuristic: when given (and tracing), each row is followed by "bounds: g1 .. g40"
+/// = the table's max x gain in 1..40 steps from the state after the step ("?" if the class is unknown).
+fn replay11b<C: case::SmbSearchCase>(data: &[u8], first: usize, prefix: usize, overrides: &[(usize, i16)], goombas: bool, trace: bool, bounds: Option<&heuristics::xpos::XPosHeuristic>) -> (State, u8, bool) {
+  use emu::{Emu, EmuResult};
+  let mut s = case::w11::w11_pipe_start::<C>();
+  let mut g = 0u8;
+  if trace { println!("step x_pos y_pos x_spd y_spd state facing moving input result"); }
+  for i in 0..prefix {
+    let input = nes_to_model(data[first + i]);
+    for &(st, ys) in overrides { if st == i { s.y_spd = ys; s.player_state = state::PlayerState::JUMPING; } }
+    let (mut ns, res) = <C as case::SmbSearchCase>::Emu::run_step(s, input);
+    let f = ROOM_FIRST_FRAME + i as i64;
+    let mut ev = RoomEvent::Nothing;
+    if goombas && res == EmuResult::Success { ev = room_enemies(f, &mut ns, &mut g); }
+    if trace {
+      let evs = match ev { RoomEvent::Nothing => String::new(), RoomEvent::Stomp(k) => format!(" STOMP{}", k), RoomEvent::Death => " DEATH".to_string() };
+      println!("{} {:#x} {:#x} {:#x} {:#x} {:?} {:?} {:?} {} {:?}{}", i, ns.x_pos, ns.y_pos, ns.x_spd, ns.y_spd, ns.player_state, ns.facing_dir, ns.moving_dir, input, res, evs);
+      if let Some(h) = bounds {
+        let v: Vec<String> = (1..=40usize).map(|k| match h.max_gain_from(&ns, k) { Some(g) => g.to_string(), None => "?".to_string() }).collect();
+        println!("bounds: {}", v.join(" "));
+      }
+    }
+    s = ns;
+    if res != EmuResult::Success { if trace { println!("stopped: {:?}", res); } return (s, g, false); }
+    if ev == RoomEvent::Death { if trace { println!("stopped: death"); } return (s, g, false); }
+  }
+  (s, g, true)
+}
+
+fn bfs11_run<C: case::SmbSearchCase, A: state::StateArray>(data: &[u8], first: usize, prefix: usize, max_steps: usize, overrides: &[(usize, i16)], root_frame: i64, any_y: bool, goombas: bool, out: Option<String>, check_path: usize) {
+  use emu::{Emu, EmuResult};
+  use heuristics::BoundsHeuristic;
+  use state::{CompressedState, StateCompressor};
+  use std::collections::{HashMap, HashSet};
+  type Key<C, A> = CompressedState<C, A>;
+  let (s, g0, alive) = replay11::<C>(data, first, prefix, overrides, goombas, false);
+  assert!(alive, "prefix replay ended early");
+  println!("root after {} prefix steps (frame {}): {}", prefix, root_frame, s);
+  println!("goombas {} (root g {:#x}); goomba x at root: {} {}", goombas, g0, goomba_x(0, root_frame), goomba_x(1, root_frame));
+  let t0 = time::precise_time_ns();
+  let h = BoundsHeuristic::new::<C>(&vec![s.clone()]);
+  let target_x: i32 = 0xc5600;
+  let target_y: i32 = 0x1a200;
+  let hval = |st: &State| -> usize { if any_y { h.get_steps_until_x_pos_at_least(st, target_x) as usize } else { h.get_steps_until_bounds_at_least(st, target_x, target_y) as usize } };
+  println!("heuristic built in {:.1}s; at root: {} steps (deadline {} steps, any_y {})", (time::precise_time_ns() - t0) as f64 / 1e9, hval(&s), max_steps, any_y);
+  // --check-path N: replay N more records of the input file as a reference path (e.g. the WR's own
+  // continuation) and report at every layer whether its state is in the frontier, else why not.
+  let mut refpath: Vec<(State, u8)> = Vec::new();
+  if check_path > 0 {
+    let (mut rs, mut rg) = (s.clone(), g0);
+    for k in 0..check_path {
+      let input = nes_to_model(data[first + prefix + k]);
+      let (mut ns, res) = <C as case::SmbSearchCase>::Emu::run_step(rs, input);
+      let f = root_frame + k as i64 + 1;
+      if res != EmuResult::Success { println!("reference path: step {} (frame {}) result {:?}, x {:#x} y {:#x}", k + 1, f, res, ns.x_pos, ns.y_pos); break; }
+      if goombas { let ev = room_enemies(f, &mut ns, &mut rg); if ev != RoomEvent::Nothing { println!("reference path: step {} event {:?}", k + 1, ev); } }
+      println!("reference path: step {} (frame {}) x {:#x} y {:#x} xspd {:#x} yspd {:#x} {:?} h {}", k + 1, f, ns.x_pos, ns.y_pos, ns.x_spd, ns.y_spd, ns.player_state, hval(&ns));
+      refpath.push((ns.clone(), rg));
+      rs = ns;
+    }
+  }
+  // model input bits: A 0x80, B 0x40, L 0x02, R 0x01
+  let inputs: Vec<u8> = (0..16u8).map(|k| { let mut v = 0u8; if k & 1 != 0 { v |= 0x80; } if k & 2 != 0 { v |= 0x40; } if k & 4 != 0 { v |= 0x02; } if k & 8 != 0 { v |= 0x01; } v }).collect();
+  // dedup key: compressed player state, goomba bits, and the frame while a live goomba is still ahead (< 48 px behind Mario)
+  let relevant = |st: &State, g: u8, f: i64| -> u32 {
+    if !goombas { return 0; }
+    let px = st.x_pos >> 8;
+    for i in 0..2usize { if g & (1 << i) == 0 && px < goomba_x(i, f) + 48 { return f as u32; } }
+    0
+  };
+  let mut visited: HashSet<(Key<C, A>, u8, u32)> = HashSet::new();
+  visited.insert((Key::<C, A>::from_state(&s), g0, relevant(&s, g0, root_frame)));
+  let mut frontier: Vec<(State, u8)> = vec![(s.clone(), g0)];
+  let mut parents: Vec<Vec<u32>> = vec![vec![0]];
+  let mut pinputs: Vec<Vec<u8>> = vec![vec![0]];
+  let mut grabs: HashMap<(usize, i32, i32, bool), u32> = HashMap::new();
+  let mut grab_paths: HashMap<(usize, bool), (u32, u8, State)> = HashMap::new();
+  let mut step = 0;
+  while step < max_steps {
+    let t1 = time::precise_time_ns();
+    let f = root_frame + step as i64 + 1;
+    let mut next: Vec<(State, u8)> = Vec::new();
+    let mut npar: Vec<u32> = Vec::new();
+    let mut ninp: Vec<u8> = Vec::new();
+    let (mut dup, mut pruned, mut dead, mut other, mut grab_n, mut stomps) = (0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
+    let mut max_x: i32 = 0;
+    for (pi, &(ref ps, pg)) in frontier.iter().enumerate() {
+      for &ib in &inputs {
+        let (mut ns, res) = <C as case::SmbSearchCase>::Emu::run_step(ps.clone(), emu::Input::from_bits_truncate(ib));
+        match res {
+          EmuResult::StateChangeFlag(cx, cy) => {
+            grab_n += 1;
+            let fpg = ns.y_pos >= target_y;
+            *grabs.entry((step + 1, ns.x_pos, ns.y_pos, fpg)).or_insert(0) += 1;
+            if cx != 0xc6 { println!("note: flag collision at column {} row {} (x {:#x} y {:#x})", cx, cy, ns.x_pos, ns.y_pos); }
+            grab_paths.entry((step + 1, fpg)).or_insert((pi as u32, ib, ns.clone()));
+          }
+          EmuResult::Success => {
+            if ns.y_pos >= 0x1d000 { dead += 1; continue; }
+            let mut ng = pg;
+            if goombas {
+              match room_enemies(f, &mut ns, &mut ng) {
+                RoomEvent::Death => { dead += 1; continue; }
+                RoomEvent::Stomp(_) => { stomps += 1; }
+                RoomEvent::Nothing => {}
+              }
+            }
+            let hh = hval(&ns);
+            if step + 1 + hh > max_steps { pruned += 1; continue; }
+            if !visited.insert((Key::<C, A>::from_state(&ns), ng, relevant(&ns, ng, f))) { dup += 1; continue; }
+            if ns.x_pos > max_x { max_x = ns.x_pos; }
+            next.push((ns, ng)); npar.push(pi as u32); ninp.push(ib);
+          }
+          _ => { other += 1; }
+        }
+      }
+    }
+    println!("layer {} (after frame {}): parents {} -> unique {}, dup {}, pruned {}, dead {}, other {}, stomps {}, grabs {}; visited {}; max x {:#x}; {:.1}s",
+      step + 1, f, frontier.len(), next.len(), dup, pruned, dead, other, stomps, grab_n, visited.len(), max_x, (time::precise_time_ns() - t1) as f64 / 1e9);
+    if step < refpath.len() {
+      let (ref rs, rg) = refpath[step];
+      let key = (Key::<C, A>::from_state(rs), rg, relevant(rs, rg, f));
+      let in_frontier = next.iter().any(|&(ref st, sg)| sg == rg && Key::<C, A>::from_state(st) == key.0);
+      let hh = hval(rs);
+      println!("  check-path step {}: {} (h {}, {}{})", step + 1, if in_frontier { "in frontier" } else { "MISSING" }, hh,
+        if step + 1 + hh > max_steps { "would be PRUNED; " } else { "" }, if visited.contains(&key) { "key visited" } else { "key not visited" });
+    }
+    if next.is_empty() { println!("no live states left after layer {}", step + 1); break; }
+    frontier = next;
+    parents.push(npar);
+    pinputs.push(ninp);
+    step += 1;
+  }
+  println!("total {:.1}s, {} states visited", (time::precise_time_ns() - t0) as f64 / 1e9, visited.len());
+  let mut gl: Vec<(&(usize, i32, i32, bool), &u32)> = grabs.iter().collect();
+  gl.sort();
+  println!("grabs (step frame x_pos y_pos fpg count):");
+  for (k, c) in gl { println!("  {} {} {:#x} {:#x} {} {}", k.0, root_frame + k.0 as i64, k.1, k.2, k.3, c); }
+  let mut best: Option<(usize, bool)> = None;
+  for fpg in &[true, false] {
+    let mut keys: Vec<&(usize, bool)> = grab_paths.keys().filter(|k| k.1 == *fpg).collect();
+    keys.sort();
+    if let Some(k) = keys.first() { best = Some(**k); break; }
+  }
+  if let Some((bstep, bfpg)) = best {
+    let &(ppi, pib, ref gs) = grab_paths.get(&(bstep, bfpg)).unwrap();
+    println!("earliest {} grab: step {} (frame {}), state {}", if bfpg { "FPG" } else { "non-FPG" }, bstep, root_frame + bstep as i64, gs);
+    let mut seq: Vec<u8> = vec![pib];
+    let mut pi = ppi as usize;
+    let mut l = bstep - 1;
+    while l > 0 { seq.push(pinputs[l][pi]); pi = parents[l][pi] as usize; l -= 1; }
+    seq.reverse();
+    emu::print_rle(seq.iter().map(|&b| emu::Input::from_bits_truncate(b)));
+    if let Some(path) = out {
+      let nes: Vec<u8> = seq.iter().map(|&b| model_to_nes(b)).collect();
+      ::std::fs::write(&path, &nes).unwrap();
+      println!("wrote {} NES-order input bytes to {}", nes.len(), path);
+    }
+  } else { println!("no grab found within {} steps", max_steps); }
+}
+
+// ---- P2.3b: the 4-2 lift (E_UndergroundArea2 page 3 col 10 row 5, id $27 LargeLiftDown; F73/F77/F78) ----
+// ext (u16, part of the search key): 0x100 | AreaParserTaskNum while not spawned; k = frames since the spawn frame
+// (0..=0xff) while alive; 0x200 once erased.
+const LIFT_X: i32 = 940;          // Enemy_X_Position (page 3, $AC) as in the dump
+const LIFT_W: i32 = 0x30;         // BoundBoxCtrlData[6]: x..x+$30, y..y+$0d (non-castle large platform)
+const LIFT_H: i32 = 0x0d;
+const LIFT_Y0: i32 = 80;          // spawn y (row 5 << 4)
+const LIFT_SPAWN_SL: i32 = 625;   // spawns on the first frame with ScreenLeft >= 625 (x 928 <= (ScreenRight+48)&~15) unless AreaParserTaskNum&7 == 7
+const LIFT_ERASE_SL: i32 = 1013;  // OffscreenBoundsCheck: erased once x < ScreenLeft - 72
+#[derive(PartialEq, Debug, Clone, Copy)]
+enum LiftEvent { Nothing, Spawn, Land, Bonk, SideL, SideR, Erase, Stomp, Kick, Death, ItemBump }
+/// Lift y after k frames since the spawn frame (no move on the spawn frame; then Y_MoveForce $f0 per frame: 15 px per 16 frames).
+fn lift_y_after(k: u16) -> i32 { if k == 0 { LIFT_Y0 } else { let m = k as i32 - 1; LIFT_Y0 + m - m / 16 } }
+fn screen_left16(s: &State) -> i32 { let x = s.x_pos >> 8; let sl = s.left_screen_edge_pos as i32; let page = if sl <= (x & 0xff) { x >> 8 } else { (x >> 8) - 1 }; (page << 8) | sl }
+fn w42_lift(pre: &State, s: &mut State, extb: &mut Ext) -> LiftEvent {
+  let mut e = extb.u16();
+  let ev = w42_lift_u16(pre, s, &mut e);
+  extb.set_u16(e);
+  ev
+}
+fn w42_lift_u16(pre: &State, s: &mut State, ext: &mut u16) -> LiftEvent {
+  use state::{Dir, PlayerState};
+  if *ext == 0x200 { return LiftEvent::Nothing; }
+  let sl_prev = screen_left16(pre);
+  let sl = screen_left16(s);
+  if *ext & 0x100 != 0 {
+    // AreaParserTaskNum (post-frame value): a burst of 8 tasks starts (value 7 after this frame) when
+    // ScrollThirtyTwo = ScreenLeft mod 32 wraps while no burst is running; the enemy loader skips frames with value 7 (F78).
+    // The enemy loader (EnemiesAndLoopsCore) runs before the frame's parser task (GameEngine: ProcELoop, then
+    // RunParser at the end), so its AreaParserTaskNum & 7 == 7 test sees the PREVIOUS frame's value (P2.5c,
+    // WR dump row 6733: an object is consumed on a burst-start frame; F78 amended). The stored value is then
+    // advanced for this frame: a burst of 8 tasks starts (7 after this frame) when ScrollThirtyTwo wraps while idle.
+    let pre = (*ext & 0xf) as i32;
+    let mut aptn = pre;
+    if aptn > 0 { aptn -= 1; } else if (sl >> 5) > (sl_prev >> 5) { aptn = 7; }
+    if sl >= LIFT_SPAWN_SL && (pre & 7) != 7 { *ext = 0; return LiftEvent::Spawn; }
+    *ext = 0x100 | aptn as u16;
+    return LiftEvent::Nothing;
+  }
+  let k = *ext + 1;
+  *ext = k;
+  let y_pre = lift_y_after(k - 1);
+  let y_post = lift_y_after(k);
+  let mut ev = LiftEvent::Nothing;
+  // LargePlatformCollision with Mario's box after this frame's movement (CheckPlayerVertical: skipped below Y $D0 / off the page)
+  if s.y_pos >= 0x10000 && s.y_pos < 0x1d000 {
+    let my = (s.y_pos >> 8) & 0xff;
+    let mx = s.x_pos >> 8;
+    // screen-relative box: GetXOffscreenBits marks the platform fully offscreen (no collision) when it is entirely
+    // right of the screen or entirely left of it; partially offscreen edges are clamped (CheckRight/LeftScreenBBox)
+    let rel = LIFT_X - sl;
+    let onscreen = rel < 256 && rel + LIFT_W >= 0;
+    let pl = if rel < 0 { 0 } else { rel };
+    let pr = if rel + LIFT_W > 255 { 255 } else { rel + LIFT_W };
+    let pt = y_pre & 0xff;
+    let pb = (y_pre + LIFT_H) & 0xff;
+    let ul = (mx - sl + 3) & 0xff; let ur = (mx - sl + 13) & 0xff; // small Mario: BoundBoxCtrlData[1] = x+3..x+13, y+$14..y+$20
+    let ut = (my + 0x14) & 0xff; let ub = (my + 0x20) & 0xff;
+    if onscreen && pl <= ur && ul <= pr && pt <= ub && ut <= pb {
+      if ((pb - ut) & 0xff) < 4 && s.y_spd < 0 { s.y_spd = 0x100 | (s.y_spd & 0xff); ev = LiftEvent::Bonk; } // head under the platform
+      if ((ub - pt) & 0xff) < 6 && s.y_spd >= 0 {
+        s.player_state = PlayerState::STANDING; ev = LiftEvent::Land; // SetCollisionFlag; PositionPlayerOnVPlat after the move
+      } else if ((ur - pl) & 0xff) < 8 {
+        if s.x_spd >= 0 { s.x_spd &= 0xff; s.x_pos -= 0x100; s.side_collision_timer = 0xf; s.collision_bits -= Dir::RIGHT; } // ImpedePlayerMove, left side of the platform
+        ev = LiftEvent::SideL;
+      } else if ((pr - ul - 1) & 0xff) < 9 {
+        if s.x_spd < 0x100 { s.x_spd &= 0xff; s.x_pos += 0x100; s.side_collision_timer = 0xf; s.collision_bits -= Dir::LEFT; } // right side
+        ev = LiftEvent::SideR;
+      }
+    }
+  }
+  if ev == LiftEvent::Land { s.y_pos = (s.y_pos & 0xff) | 0x10000 | ((y_post - 32) << 8); s.y_spd = 0; } // PositionPlayerOnVPlat: Y = lift Y - 32, Player_Y_Speed = Player_Y_MoveForce = 0; Player_YMF_Dummy (the y_pos fraction here) is NOT cleared
+  if sl >= LIFT_ERASE_SL { *ext = 0x200; if ev == LiftEvent::Nothing { ev = LiftEvent::Erase; } }
+  ev
+}
+/// P2.5c-2: the per-record object state ("ext") is a byte array: bytes 0..2 = the u16 the lift / warp-stage hooks use
+/// (kept for compatibility), the rest = the 4-2 enemy slots (w42enemies). Arrays longer than 32 bytes have no
+/// Ord/Hash in this Rust, hence the newtype with slice-based impls.
+pub const EXTN: usize = 64;
+#[derive(Clone, Copy)]
+pub struct Ext(pub [u8; EXTN]);
+impl Ext {
+  pub fn zero() -> Ext { Ext([0u8; EXTN]) }
+  pub fn from_u16(v: u16) -> Ext { let mut e = Ext::zero(); e.set_u16(v); e }
+  #[inline] pub fn u16(&self) -> u16 { self.0[0] as u16 | ((self.0[1] as u16) << 8) }
+  #[inline] pub fn set_u16(&mut self, v: u16) { self.0[0] = (v & 0xff) as u8; self.0[1] = (v >> 8) as u8; }
+  pub fn hex(&self) -> String { let n = self.0.iter().rposition(|&b| b != 0).map_or(0, |i| i + 1); self.0[..n].iter().map(|b| format!("{:02x}", b)).collect::<Vec<_>>().join("") }
+}
+impl PartialEq for Ext { fn eq(&self, o: &Ext) -> bool { self.0[..] == o.0[..] } }
+impl Eq for Ext {}
+impl PartialOrd for Ext { fn partial_cmp(&self, o: &Ext) -> Option<::std::cmp::Ordering> { Some(self.cmp(o)) } }
+impl Ord for Ext { fn cmp(&self, o: &Ext) -> ::std::cmp::Ordering { self.0[..].cmp(&o.0[..]) } }
+impl ::std::hash::Hash for Ext { fn hash<H: ::std::hash::Hasher>(&self, h: &mut H) { self.0[..].hash(h) } }
+impl ::std::fmt::Debug for Ext { fn fmt(&self, f: &mut ::std::fmt::Formatter) -> ::std::fmt::Result { write!(f, "ext:{}", self.hex()) } }
+impl ::std::fmt::LowerHex for Ext { fn fmt(&self, f: &mut ::std::fmt::Formatter) -> ::std::fmt::Result { write!(f, "{}", self.hex()) } }
+type Hook = fn(&State, &mut State, &mut Ext) -> LiftEvent;
+/// P2.5c-2: the 4-2 enemy hook (`--enemies`): the lift's u16 in bytes 0..2 (its spawn now comes from the generic
+/// enemy loader, its collision/erase from `w42_lift_u16`), the enemy slots in bytes 2..64 (w42enemies::Slots).
+/// Returns Bonk/Land/... from the lift as before; a death by an enemy is reported as LiftEvent::Death.
+fn w42_enemies(pre: &State, s: &mut State, ext: &mut Ext) -> LiftEvent {
+  use options::BlockStates;
+  use w42enemies::{Frame, Slots, EnemyEvent};
+  let mut slots = Slots::unpack(&ext.0);
+  let lift_u16 = ext.u16();
+  let mut lift_live = lift_u16 < 0x100;
+  let frame = s.blocks.frame;
+  let aptn_pre = pre.blocks.aptn;
+  // H34: a bump of the (64,3) vine cell (CELLS bit 3) runs Setup_Vine the same frame, BEFORE the enemy loop:
+  // slot 5 gets the growing vine (x 1024 = the block's column, y 80 = the block's top) and VineFlagOffset -> 1.
+  if s.blocks.used & (1 << 3) & !pre.blocks.used != 0 && slots.vineflag == 0 {
+    let t = &mut slots.s[5];
+    t.class = w42enemies::CLASS_VINE; t.state = 0; t.x = 1024; t.y = 80; t.itimer = 0; t.ftimer = 0; t.yhi = 1; t.dn = 0;
+    slots.vineflag = 1;
+  }
+  let f = Frame {
+    sl16: screen_left16(s),
+    fc_odd: ((<case::w42::W42MainBlocks as BlockStates>::FC0 as u16 + frame as u16) & 1) != 0,
+    fc_b1: ((<case::w42::W42MainBlocks as BlockStates>::FC0 as u16 + frame as u16) & 2) != 0,
+    itc_tick: ((<case::w42::W42MainBlocks as BlockStates>::IP0 as i32 - frame as i32 + 1) % 21 + 21) % 21 == 0,
+    aptn_pre,
+    px: s.x_pos >> 8, py: (s.y_pos >> 8) & 0xff, pys_pos: (s.y_spd >> 8) > 0,
+    bx: emu::pre_bg_pos().0 >> 8, by: (emu::pre_bg_pos().1 >> 8) & 0xff,
+    bounce_cell: s.blocks.bounce_cell,
+  };
+  // the parser ran a render task this frame iff the task number changed (paused frames keep it)
+  let plant_col = if s.blocks.aptn != aptn_pre && (s.blocks.aptn == 7 || s.blocks.aptn == 3) { Some(s.blocks.parser_col) } else { None };
+  let was_live = lift_live;
+  let ev = if (s.y_pos >> 16) == 1 { slots.step(&f, s, &mut lift_live, plant_col) } else { EnemyEvent::Nothing };
+  slots.pack(&mut ext.0);
+  // the lift: spawned by the loader this frame -> k = 0; alive -> the validated platform logic; erased -> free its slot
+  let mut lev = LiftEvent::Nothing;
+  if lift_live && !was_live { ext.set_u16(0); lev = LiftEvent::Spawn; }
+  else if lift_live {
+    let mut e = lift_u16;
+    lev = w42_lift_u16(pre, s, &mut e);
+    ext.set_u16(e);
+    if e == 0x200 { let mut sl2 = Slots::unpack(&ext.0); for i in 0..6 { if sl2.s[i].class == w42enemies::CLASS_LIFT { sl2.s[i].class = w42enemies::CLASS_EMPTY; sl2.s[i].state = 0; } } sl2.pack(&mut ext.0); }
+  }
+  // H34 (2026-08-24): the (64,3) vine bump is MODELED (slot-5 vine + the loader-injected inert occupant — the
+  // WR's slot management, F100); the remaining item cells ((28,7)/(55,7) mushroom, (81,7) star — CELLS bits
+  // 7/11/15) still spawn objects the model does not have: searches refuse those transitions; traces report them.
+  const ITEM_MASK: u16 = (1 << 7) | (1 << 11) | (1 << 15);
+  if ev != EnemyEvent::Death && s.blocks.used & ITEM_MASK & !pre.blocks.used != 0 { return LiftEvent::ItemBump; }
+  // The grown vine's climbing column ((64, rows 0..2), written as $26 as the slot-5 vine grows): the model has no
+  // climbing, so Mario entering that region with a vine present is refused like an item bump (documented
+  // over-refusal: any of his collision points could touch a climbable cell there). x+2 <= 1039 && x+13 >= 1024
+  // -> x in [1011, 1037]; body above the brick row -> Y < 62.
+  if slots.vineflag != 0 && s.x_pos >= 1011 << 8 && s.x_pos < 1038 << 8 && s.y_pos < 0x13e00 { return LiftEvent::ItemBump; }
+  // F40 (the wrong-warp condition, learned from emulator round 1): the warp destination is AreaPointer as last
+  // written by a parsed row-$0e command; the wrong warp needs the (page 5, col 15) command (module ENEMY_DATA
+  // offsets 15..18: 0xfe, 0x42, 0x68 -> pointer $42, EntrancePage 8) still UNPARSED through the area load. A
+  // state whose loader consumed it (eoff jumps 15 -> 18) warps to the page-8 garbage; a state whose scroll
+  // reached the command's parse range (ScreenRight + 48 >= 1520 <=> sl16 >= 1217; the WR enters at exactly
+  // 1216) lets the cutscene consume it. Both are route-dead for the wrong warp: refuse like an item bump.
+  // Only the final approach (Mario x >= ~1329) can reach sl16 1217, so earlier segments are unaffected.
+  if slots.eoff >= 16 { return LiftEvent::ItemBump; }
+  if screen_left16(s) >= 1217 { return LiftEvent::ItemBump; }
+  match ev { EnemyEvent::Death => LiftEvent::Death, EnemyEvent::Stomp => LiftEvent::Stomp, EnemyEvent::Kick => LiftEvent::Kick, EnemyEvent::Nothing => lev }
+}
+
+/// P2.3c-2: route-phase hook for the 4-2 warp zone (`--stage`): ext = 1 once X >= 957 (the drop through the gap at
+/// cols 60..61 is the only way under the roof), so W42Warp's staged bound can add the forced return.
+fn w42_warp_stage(_pre: &State, s: &mut State, ext: &mut Ext) -> LiftEvent { if s.x_pos >= case::w42::WARP_DROP_X { ext.set_u16(1); } LiftEvent::Nothing }
+
+/// Generic replay (P2.3a): run a case's model from start_states()[0] through `n` NES-order records starting at
+/// `first`, optionally tracing each step in the trace11pipe row format. Returns (state, alive).
+fn replayc<C: case::SmbSearchCase>(data: &[u8], first: usize, n: usize, trace: bool) -> (State, bool) { let (s, _, a) = replayce::<C>(data, first, n, trace, None, 0); (s, a) }
+/// P2.3c-2c: replay each input file with the position-goal bound printed per step (see the `traceh` mode).
+fn traceh_run<C: case::SmbSearchCase>(files: &[String], first: usize, n: usize, hook: Option<Hook>, ext0: u16, gxy: Option<(i32, i32)>, drift: bool) {
+  use emu::{Emu, EmuResult};
+  use case::SmbSearchCase;
+  use heuristics::SearchGoal;
+  let mut goal = C::SearchGoal::new();
+  goal.set_bounce_band(hook.map_or(false, |h| h as usize == w42_enemies as usize));
+  match gxy { Some((gx, gy)) => goal.set_position_goal(gx, gy), None => { goal.set_drift_bound(drift); } }
+  let hof = |g: &C::SearchGoal, st: &State, e: u16, step: usize| -> String {
+    let d = match gxy { Some((gx, gy)) => g.steps_until_xy(&mut st.clone(), gx, gy), None => g.distance_to_goal_heuristic_ext(&mut st.clone(), e, step as state::Dist) };
+    match d { Some(d) => d.to_string(), None => "?".to_string() }
+  };
+  let track = <<C as options::Options>::ScrollPos as options::ScrollPos>::TRACK_SCROLL_POS;
+  let extra = |st: &State| -> String { if gxy.is_none() && track { format!(" rel {} t {}", (st.x_pos >> 8) - screen_left16(st), st.side_collision_timer) } else { String::new() } };
+  for f in files {
+    let data = ::std::fs::read(f).unwrap();
+    let mut s = C::start_states()[0].clone();
+    let mut ext = Ext::from_u16(ext0);
+    println!("=== {}", f);
+    println!("step x_pos y_pos x_spd y_spd state h goal result");
+    println!("0 {:#x} {:#x} {:#x} {:#x} {:?} {} {} Root{}", s.x_pos, s.y_pos, s.x_spd, s.y_spd, s.player_state, hof(&goal, &s, ext.u16(), 0), gxy.map_or(false, |(gx, gy)| s.x_pos >= gx && s.y_pos <= gy) as u8, extra(&s));
+    for i in 0..n {
+      let input = nes_to_model(data[first + i]);
+      let (mut ns, res) = <C as SmbSearchCase>::Emu::run_step(s.clone(), input);
+      let mut dead = false;
+      let mut bump = false;
+      if let Some(h) = hook { if res == EmuResult::Success { let ev = h(&s, &mut ns, &mut ext); dead = ev == LiftEvent::Death; bump = ev == LiftEvent::ItemBump; } }
+      let g = match gxy { Some((gx, gy)) => !dead && res == EmuResult::Success && ns.x_pos >= gx && ns.y_pos <= gy, None => goal.is_goal_state(&ns, &res) && !goal_refused(hook, &ns) };
+      println!("{} {:#x} {:#x} {:#x} {:#x} {:?} {} {} {:?}{}{}{}", i + 1, ns.x_pos, ns.y_pos, ns.x_spd, ns.y_spd, ns.player_state, hof(&goal, &ns, ext.u16(), i + 1), g as u8, res, if dead { " DEAD" } else { "" }, if bump { " ITEMBUMP" } else { "" }, extra(&ns));
+      s = ns;
+      if res != EmuResult::Success || dead { break; }
+    }
+  }
+}
+/// P2.3c-5: the F40 refusal also applies to the goal transition itself (the search tests the goal before the hook
+/// runs): a pipe entry whose own frame scrolled ScreenLeft16 to >= 1217 warps wrong, like any refused state.
+fn goal_refused(hook: Option<Hook>, ns: &State) -> bool { hook.map_or(false, |h| h as usize == w42_enemies as usize) && screen_left16(ns) >= 1217 }
+/// replayc with an optional per-frame object hook (e.g. the 4-2 lift) carrying `ext`; returns (state, ext, alive).
+fn replayce<C: case::SmbSearchCase>(data: &[u8], first: usize, n: usize, trace: bool, hook: Option<Hook>, ext0: u16) -> (State, Ext, bool) {
+  use emu::{Emu, EmuResult};
+  use case::SmbSearchCase;
+  let mut s = C::start_states()[0].clone();
+  let mut ext = Ext::from_u16(ext0);
+  if trace { println!("step x_pos y_pos x_spd y_spd state facing moving input result"); }
+  for i in 0..n {
+    let input = nes_to_model(data[first + i]);
+    let (mut ns, res) = <C as SmbSearchCase>::Emu::run_step(s.clone(), input);
+    let mut evs = String::new();
+    if let Some(h) = hook { if res == EmuResult::Success { let ev = h(&s, &mut ns, &mut ext); let eu = ext.u16(); if ev == LiftEvent::Death { evs = " DEATH".to_string(); } else if ev == LiftEvent::Stomp || ev == LiftEvent::Kick || ev == LiftEvent::ItemBump { evs = format!(" {:?}", ev).to_uppercase(); } else if ev != LiftEvent::Nothing || eu < 0x100 { evs = format!(" lift {:?} k {} y {}", ev, eu, if eu < 0x100 { lift_y_after(eu) } else { -1 }); } } }
+    if trace {
+      println!("{} {:#x} {:#x} {:#x} {:#x} {:?} {:?} {:?} {} {:?}{}", i, ns.x_pos, ns.y_pos, ns.x_spd, ns.y_spd, ns.player_state, ns.facing_dir, ns.moving_dir, input, res, evs);
+      if <<C as options::Options>::ScrollPos as options::ScrollPos>::TRACK_SCROLL_POS { println!("scroll: {} sct {}", ns.left_screen_edge_pos, ns.side_collision_timer); }
+      if <<C as options::Options>::BlockStates as options::BlockStates>::ON { let b = &ns.blocks; println!("blocks: bounce {} used {:#x} cbt {}/{} f {} aptn {} bp {} col {} vb1 {} a6 {}", b.bounce_cell, b.used, b.coin_brick_flag, b.coin_brick_timer, b.frame, b.aptn, b.burst_pending, b.parser_col, b.vbuf1, b.addrctrl6); }
+      if hook.map_or(false, |h| h as usize == w42_enemies as usize) { println!("slots: {}", w42enemies::Slots::unpack(&ext.0).describe()); }
+    }
+    s = ns;
+    if res != EmuResult::Success { if trace { println!("stopped: {:?}", res); } return (s, ext, false); }
+    if evs.contains("Death") { if trace { println!("stopped: death"); } return (s, ext, false); }
+  }
+  (s, ext, true)
+}
+
+/// Generic per-layer exhaustive BFS (P2.3a, see the `bfsc` mode): in-memory frontier, global visited set of
+/// compressed keys, parents/inputs kept per layer for path reconstruction, expansion over `threads` threads.
+/// The case's SearchGoal supplies the deadline heuristic (a lower bound on the steps still needed, so pruning
+/// `step + h > max_steps` is exact) and the goal test.
+/// P2.3c-1: `bfs11c`'s external-memory per-layer BFS generalised to any case (`SmbSearchCase`) with the object hook
+/// (`Hook`, ext u16 in the record) and the case's `SearchGoal` as deadline bound and goal test — the `bfsc` semantics
+/// (goal test before the hook, dedup on (key, ext), all 16 inputs) with `bfs11c`'s memory behaviour (parents streamed
+/// from `layer_NNN.bin`, accumulators capped at `--acc-mb` per thread and spilled as sorted runs, k-way merge into the
+/// next layer, `--resume N`, `--stop-step N`). Records are 24 bytes: key (≤ 22 bytes) + ext (2 bytes LE).
+/// `--check-path N` replays N more input records as a reference path and binary-searches each layer file for it.
+/// Stops at the first layer with a goal (= the optimum under the deadline) and prints the `bfscx-path` command.
+const XREC: usize = 96;
+#[derive(Clone, Copy)]
+#[repr(C)]
+struct XRec([u8; XREC]);
+impl XRec { fn zero() -> XRec { XRec([0u8; XREC]) } }
+impl ::std::ops::Deref for XRec { type Target = [u8; XREC]; fn deref(&self) -> &[u8; XREC] { &self.0 } }
+impl ::std::ops::DerefMut for XRec { fn deref_mut(&mut self) -> &mut [u8; XREC] { &mut self.0 } }
+impl PartialEq for XRec { fn eq(&self, o: &XRec) -> bool { self.0[..] == o.0[..] } }
+impl Eq for XRec {}
+impl PartialOrd for XRec { fn partial_cmp(&self, o: &XRec) -> Option<::std::cmp::Ordering> { Some(self.cmp(o)) } }
+impl Ord for XRec { fn cmp(&self, o: &XRec) -> ::std::cmp::Ordering { self.0[..].cmp(&o.0[..]) } }
+impl ::std::fmt::Debug for XRec { fn fmt(&self, f: &mut ::std::fmt::Formatter) -> ::std::fmt::Result { write!(f, "{:?}", &self.0[..]) } }
+fn xrec_bytes(v: &[XRec]) -> &[u8] { unsafe { ::std::slice::from_raw_parts(v.as_ptr() as *const u8, v.len() * XREC) } }
+#[inline] fn rec_ext(r: &XRec, klen: usize) -> Ext { let mut e = Ext::zero(); e.0.copy_from_slice(&r[klen..klen + EXTN]); e }
+#[inline] fn rec_set_ext(r: &mut XRec, klen: usize, e: &Ext) { r[klen..klen + EXTN].copy_from_slice(&e.0); }
+fn xread_full_at(f: &::std::fs::File, buf: &mut [u8], mut off: u64) -> ::std::io::Result<()> {
+  use std::os::unix::fs::FileExt;
+  let mut done = 0usize;
+  while done < buf.len() {
+    let k = f.read_at(&mut buf[done..], off)?;
+    if k == 0 { return Err(::std::io::Error::new(::std::io::ErrorKind::UnexpectedEof, "short read")); }
+    done += k; off += k as u64;
+  }
+  Ok(())
+}
+/// Binary search for `target` in a sorted layer file of XREC-byte records.
+fn xlayer_contains(path: &str, target: &XRec) -> bool {
+  use std::fs::File;
+  let f = File::open(path).unwrap();
+  let n = (::std::fs::metadata(path).unwrap().len() / XREC as u64) as usize;
+  let (mut lo, mut hi) = (0usize, n);
+  let mut r: XRec = XRec::zero();
+  while lo < hi {
+    let mid = (lo + hi) / 2;
+    xread_full_at(&f, &mut r.0[..], (mid * XREC) as u64).unwrap();
+    if &r < target { lo = mid + 1; } else if &r > target { hi = mid; } else { return true; }
+  }
+  false
+}
+/// P2.3c-2c: goal test / bound with the optional position-goal override (see bfscx_run).
+fn xy_goal<G: heuristics::SearchGoal>(g: &G, ns: &State, res: &emu::EmuResult, gx: Option<i32>, gy: Option<i32>) -> bool {
+  match gx { Some(gx) => *res == emu::EmuResult::Success && ns.x_pos >= gx && gy.map_or(true, |gy| ns.y_pos <= gy), None => g.is_goal_state(ns, res) }
+}
+fn xy_h<G: heuristics::SearchGoal>(g: &G, st: &State, e: u16, step: usize, gx: Option<i32>, gy: Option<i32>) -> Option<usize> {
+  let mut c = st.clone();
+  match (gx, gy) {
+    (Some(gx), Some(gy)) => g.steps_until_xy(&mut c, gx, gy).map(|d| d as usize), // P2.3c-2c: y-coupled (ygate) if the case has one
+    (Some(gx), None) => g.steps_until_x_at_least(&mut c, gx).map(|d| d as usize),
+    _ => g.distance_to_goal_heuristic_ext(&mut c, e, step as state::Dist).map(|d| d as usize),
+  }
+}
+fn bfscx_run<C: case::SmbSearchCase + 'static, A: state::StateArray + Send + 'static>(data: &[u8], first: usize, prefix: usize, max_steps: usize, out: Option<String>, check_path: usize, threads: usize, hook: Option<Hook>, ext0: u16, layer_dir: Option<String>, resume: Option<usize>, acc_mb: usize, stop_step: usize, goal_xy: (Option<i32>, Option<i32>), drift: bool, beam: Option<usize>, beam_offset: bool, log_offset: bool)
+    where C::SearchGoal: Send + Sync {
+  // P2.3c-2c: `--goal-x PX [--goal-y PY]` replaces the case's goal by "x_pos >= PX (and Player_Y <= PY) after a Success step" and its
+  // bound by the case's x-only table to PX (SearchGoal::steps_until_x_at_least) — segment searches whose results chain into a reference path.
+  let (goal_x, goal_y) = goal_xy;
+  use emu::{Emu, EmuResult};
+  use heuristics::SearchGoal;
+  use state::{CompressedState, StateCompressor};
+  use std::collections::{BinaryHeap, HashMap};
+  use std::cmp::Reverse;
+  use std::fs::File;
+  use std::io::{BufReader, BufWriter, Read, Write};
+  use std::sync::Arc;
+  type Key<C, A> = CompressedState<C, A>;
+  let (s, e0, alive) = replayce::<C>(data, first, prefix, false, hook, ext0);
+  assert!(alive, "prefix replay ended early");
+  let k0 = Key::<C, A>::from_state(&s);
+  let klen = k0.as_bytes().len();
+  assert!(klen + EXTN <= XREC, "key too long for the {}-byte record", XREC);
+  {
+    let d = k0.decompress();
+    assert!(Key::<C, A>::from_state(&d).as_bytes() == k0.as_bytes() && d.x_pos == s.x_pos && d.y_pos == s.y_pos && d.x_spd == s.x_spd && d.y_spd == s.y_spd && d.blocks == s.blocks && d.left_screen_edge_pos == s.left_screen_edge_pos, "decompress(compress(root)) != root:\n{}\nvs\n{}", d, s);
+  }
+  let mk_rec = |k: &Key<C, A>, e: &Ext| -> XRec { let mut r: XRec = XRec::zero(); r[..klen].copy_from_slice(k.as_bytes()); rec_set_ext(&mut r, klen, e); r };
+  let ldir = layer_dir.unwrap_or_else(|| "bfscx_layers".to_string());
+  ::std::fs::create_dir_all(format!("{}/tmp", ldir)).unwrap();
+  let layer_path = |l: usize| format!("{}/layer_{:03}.bin", ldir, l);
+  println!("root after {} prefix steps (record {}): {}", prefix, first + prefix, s);
+  println!("object hook {} (root ext {:x}); key {} bytes (+{} ext, {}-byte records); threads {}; layer dir {}; acc {} MB/thread; resume {:?}; inputs: all 16 A/B/L/R combinations", hook.is_some(), e0, klen, EXTN, XREC, threads, ldir, acc_mb, resume);
+  let t0 = time::precise_time_ns();
+  let mut goal0 = C::SearchGoal::new();
+  goal0.set_bounce_band(hook.map_or(false, |h| h as usize == w42_enemies as usize)); // P2.5c-2: enemy-aware -> the y bound admits stomp bounces
