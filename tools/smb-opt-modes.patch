+  /// The case bound: the x table to X 1348, joined with the drift bound when it is on (P2.3c-5).
+  fn distance_to_goal_heuristic(&self, s: &mut State, _: Dist) -> Option<Dist> {
+    let hx = self.h.get_steps_until_x_pos_at_least(s, 0x54400);
+    Some(match self.drift { Some(ref d) => ::std::cmp::max(hx, d.h(s)), None => hx })
+  }
+  fn steps_until_x_at_least(&self, s: &mut State, x: i32) -> Option<Dist> { Some(self.h.get_steps_until_x_pos_at_least(s, x)) }
+  fn set_position_goal(&mut self, gx: i32, gy: i32) -> () {
+    let mut surf = surfaces_from_blocks::<BB42>(98);
+    if self.bounce_band {
+      // the highest a stompable 4-2 enemy can be under Mario: a goomba of the $3A group on the Y-112 floor (enemy y
+      // 120, Mario's box bottom Y+32 >= its box top y+14 -> Y >= 102); every other stompable object (the goombas
+      // after falling, the koopa, the beetle, kicked shells) is lower. Existence needs the group's spawn
