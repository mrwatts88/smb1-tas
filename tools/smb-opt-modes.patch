+impl SearchGoal for W42Main {
+  fn new() -> Self { return Self { h: XPosHeuristic::new::<Self>(&<Self as super::SmbSearchCase>::start_states()), goal_gate: None, bounce_band: false, drift: None }; }
+  fn set_bounce_band(&mut self, on: bool) -> () { self.bounce_band = on; }
+  fn set_drift_bound(&mut self, on: bool) -> bool {
+    if on { let d = DriftBound::new::<BB42>(&self.h); println!("{}", d.note); self.drift = Some(d); } else { self.drift = None; }
