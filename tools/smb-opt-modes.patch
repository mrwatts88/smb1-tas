+fn bfs11_run<C: case::SmbSearchCase, A: state::StateArray>(data: &[u8], first: usize, prefix: usize, max_steps: usize, overrides: &[(usize, i16)], root_frame: i64, any_y: bool, goombas: bool, out: Option<String>, check_path: usize) {
+  use emu::{Emu, EmuResult};
+  use heuristics::BoundsHeuristic;
+  use state::{CompressedState, StateCompressor};
+  use std::collections::{HashMap, HashSet};
+  type Key<C, A> = CompressedState<C, A>;
+  let (s, g0, alive) = replay11::<C>(data, first, prefix, overrides, goombas, false);
+  assert!(alive, "prefix replay ended early");
+  println!("root after {} prefix steps (frame {}): {}", prefix, root_frame, s);
+  println!("goombas {} (root g {:#x}); goomba x at root: {} {}", goombas, g0, goomba_x(0, root_frame), goomba_x(1, root_frame));
+  let t0 = time::precise_time_ns();
+  let h = BoundsHeuristic::new::<C>(&vec![s.clone()]);
+  let target_x: i32 = 0xc5600;
+  let target_y: i32 = 0x1a200;
+  let hval = |st: &State| -> usize { if any_y { h.get_steps_until_x_pos_at_least(st, target_x) as usize } else { h.get_steps_until_bounds_at_least(st, target_x, target_y) as usize } };
+  println!("heuristic built in {:.1}s; at root: {} steps (deadline {} steps, any_y {})", (time::precise_time_ns() - t0) as f64 / 1e9, hval(&s), max_steps, any_y);
+  // --check-path N: replay N more records of the input file as a reference path (e.g. the WR's own
+  // continuation) and report at every layer whether its state is in the frontier, else why not.
+  let mut refpath: Vec<(State, u8)> = Vec::new();
+  if check_path > 0 {
+    let (mut rs, mut rg) = (s.clone(), g0);
+    for k in 0..check_path {
+      let input = nes_to_model(data[first + prefix + k]);
+      let (mut ns, res) = <C as case::SmbSearchCase>::Emu::run_step(rs, input);
+      let f = root_frame + k as i64 + 1;
+      if res != EmuResult::Success { println!("reference path: step {} (frame {}) result {:?}, x {:#x} y {:#x}", k + 1, f, res, ns.x_pos, ns.y_pos); break; }
+      if goombas { let ev = room_enemies(f, &mut ns, &mut rg); if ev != RoomEvent::Nothing { println!("reference path: step {} event {:?}", k + 1, ev); } }
+      println!("reference path: step {} (frame {}) x {:#x} y {:#x} xspd {:#x} yspd {:#x} {:?} h {}", k + 1, f, ns.x_pos, ns.y_pos, ns.x_spd, ns.y_spd, ns.player_state, hval(&ns));
+      refpath.push((ns.clone(), rg));
+      rs = ns;
+    }
+  }
+  // model input bits: A 0x80, B 0x40, L 0x02, R 0x01
+  let inputs: Vec<u8> = (0..16u8).map(|k| { let mut v = 0u8; if k & 1 != 0 { v |= 0x80; } if k & 2 != 0 { v |= 0x40; } if k & 4 != 0 { v |= 0x02; } if k & 8 != 0 { v |= 0x01; } v }).collect();
+  // dedup key: compressed player state, goomba bits, and the frame while a live goomba is still ahead (< 48 px behind Mario)
+  let relevant = |st: &State, g: u8, f: i64| -> u32 {
+    if !goombas { return 0; }
+    let px = st.x_pos >> 8;
+    for i in 0..2usize { if g & (1 << i) == 0 && px < goomba_x(i, f) + 48 { return f as u32; } }
+    0
+  };
+  let mut visited: HashSet<(Key<C, A>, u8, u32)> = HashSet::new();
+  visited.insert((Key::<C, A>::from_state(&s), g0, relevant(&s, g0, root_frame)));
+  let mut frontier: Vec<(State, u8)> = vec![(s.clone(), g0)];
+  let mut parents: Vec<Vec<u32>> = vec![vec![0]];
+  let mut pinputs: Vec<Vec<u8>> = vec![vec![0]];
+  let mut grabs: HashMap<(usize, i32, i32, bool), u32> = HashMap::new();
+  let mut grab_paths: HashMap<(usize, bool), (u32, u8, State)> = HashMap::new();
+  let mut step = 0;
+  while step < max_steps {
+    let t1 = time::precise_time_ns();
+    let f = root_frame + step as i64 + 1;
+    let mut next: Vec<(State, u8)> = Vec::new();
+    let mut npar: Vec<u32> = Vec::new();
+    let mut ninp: Vec<u8> = Vec::new();
+    let (mut dup, mut pruned, mut dead, mut other, mut grab_n, mut stomps) = (0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
+    let mut max_x: i32 = 0;
+    for (pi, &(ref ps, pg)) in frontier.iter().enumerate() {
+      for &ib in &inputs {
+        let (mut ns, res) = <C as case::SmbSearchCase>::Emu::run_step(ps.clone(), emu::Input::from_bits_truncate(ib));
+        match res {
+          EmuResult::StateChangeFlag(cx, cy) => {
+            grab_n += 1;
+            let fpg = ns.y_pos >= target_y;
+            *grabs.entry((step + 1, ns.x_pos, ns.y_pos, fpg)).or_insert(0) += 1;
+            if cx != 0xc6 { println!("note: flag collision at column {} row {} (x {:#x} y {:#x})", cx, cy, ns.x_pos, ns.y_pos); }
+            grab_paths.entry((step + 1, fpg)).or_insert((pi as u32, ib, ns.clone()));
+          }
+          EmuResult::Success => {
+            if ns.y_pos >= 0x1d000 { dead += 1; continue; }
+            let mut ng = pg;
+            if goombas {
+              match room_enemies(f, &mut ns, &mut ng) {
+                RoomEvent::Death => { dead += 1; continue; }
+                RoomEvent::Stomp(_) => { stomps += 1; }
+                RoomEvent::Nothing => {}
+              }
+            }
+            let hh = hval(&ns);
+            if step + 1 + hh > max_steps { pruned += 1; continue; }
+            if !visited.insert((Key::<C, A>::from_state(&ns), ng, relevant(&ns, ng, f))) { dup += 1; continue; }
+            if ns.x_pos > max_x { max_x = ns.x_pos; }
+            next.push((ns, ng)); npar.push(pi as u32); ninp.push(ib);
+          }
+          _ => { other += 1; }
+        }
+      }
+    }
+    println!("layer {} (after frame {}): parents {} -> unique {}, dup {}, pruned {}, dead {}, other {}, stomps {}, grabs {}; visited {}; max x {:#x}; {:.1}s",
+      step + 1, f, frontier.len(), next.len(), dup, pruned, dead, other, stomps, grab_n, visited.len(), max_x, (time::precise_time_ns() - t1) as f64 / 1e9);
+    if step < refpath.len() {
+      let (ref rs, rg) = refpath[step];
+      let key = (Key::<C, A>::from_state(rs), rg, relevant(rs, rg, f));
+      let in_frontier = next.iter().any(|&(ref st, sg)| sg == rg && Key::<C, A>::from_state(st) == key.0);
+      let hh = hval(rs);
+      println!("  check-path step {}: {} (h {}, {}{})", step + 1, if in_frontier { "in frontier" } else { "MISSING" }, hh,
+        if step + 1 + hh > max_steps { "would be PRUNED; " } else { "" }, if visited.contains(&key) { "key visited" } else { "key not visited" });
+    }
+    if next.is_empty() { println!("no live states left after layer {}", step + 1); break; }
+    frontier = next;
+    parents.push(npar);
+    pinputs.push(ninp);
+    step += 1;
+  }
+  println!("total {:.1}s, {} states visited", (time::precise_time_ns() - t0) as f64 / 1e9, visited.len());
+  let mut gl: Vec<(&(usize, i32, i32, bool), &u32)> = grabs.iter().collect();
+  gl.sort();
+  println!("grabs (step frame x_pos y_pos fpg count):");
+  for (k, c) in gl { println!("  {} {} {:#x} {:#x} {} {}", k.0, root_frame + k.0 as i64, k.1, k.2, k.3, c); }
+  let mut best: Option<(usize, bool)> = None;
+  for fpg in &[true, false] {
+    let mut keys: Vec<&(usize, bool)> = grab_paths.keys().filter(|k| k.1 == *fpg).collect();
+    keys.sort();
+    if let Some(k) = keys.first() { best = Some(**k); break; }
+  }
+  if let Some((bstep, bfpg)) = best {
+    let &(ppi, pib, ref gs) = grab_paths.get(&(bstep, bfpg)).unwrap();
+    println!("earliest {} grab: step {} (frame {}), state {}", if bfpg { "FPG" } else { "non-FPG" }, bstep, root_frame + bstep as i64, gs);
+    let mut seq: Vec<u8> = vec![pib];
+    let mut pi = ppi as usize;
+    let mut l = bstep - 1;
+    while l > 0 { seq.push(pinputs[l][pi]); pi = parents[l][pi] as usize; l -= 1; }
+    seq.reverse();
+    emu::print_rle(seq.iter().map(|&b| emu::Input::from_bits_truncate(b)));
+    if let Some(path) = out {
+      let nes: Vec<u8> = seq.iter().map(|&b| model_to_nes(b)).collect();
+      ::std::fs::write(&path, &nes).unwrap();
+      println!("wrote {} NES-order input bytes to {}", nes.len(), path);
+    }
+  } else { println!("no grab found within {} steps", max_steps); }
+}
+
+// ---- P2.3b: the 4-2 lift (E_UndergroundArea2 page 3 col 10 row 5, id $27 LargeLiftDown; F73/F77/F78) ----
+// ext (u16, part of the search key): 0x100 | AreaParserTaskNum while not spawned; k = frames since the spawn frame
+// (0..=0xff) while alive; 0x200 once erased.
+const LIFT_X: i32 = 940;          // Enemy_X_Position (page 3, $AC) as in the dump
+const LIFT_W: i32 = 0x30;         // BoundBoxCtrlData[6]: x..x+$30, y..y+$0d (non-castle large platform)
+const LIFT_H: i32 = 0x0d;
+const LIFT_Y0: i32 = 80;          // spawn y (row 5 << 4)
+const LIFT_SPAWN_SL: i32 = 625;   // spawns on the first frame with ScreenLeft >= 625 (x 928 <= (ScreenRight+48)&~15) unless AreaParserTaskNum&7 == 7
+const LIFT_ERASE_SL: i32 = 1013;  // OffscreenBoundsCheck: erased once x < ScreenLeft - 72
+#[derive(PartialEq, Debug, Clone, Copy)]
+enum LiftEvent { Nothing, Spawn, Land, Bonk, SideL, SideR, Erase }
+/// Lift y after k frames since the spawn frame (no move on the spawn frame; then Y_MoveForce $f0 per frame: 15 px per 16 frames).
+fn lift_y_after(k: u16) -> i32 { if k == 0 { LIFT_Y0 } else { let m = k as i32 - 1; LIFT_Y0 + m - m / 16 } }
+fn screen_left16(s: &State) -> i32 { let x = s.x_pos >> 8; let sl = s.left_screen_edge_pos as i32; let page = if sl <= (x & 0xff) { x >> 8 } else { (x >> 8) - 1 }; (page << 8) | sl }
+fn w42_lift(pre: &State, s: &mut State, ext: &mut u16) -> LiftEvent {
+  use state::{Dir, PlayerState};
+  if *ext == 0x200 { return LiftEvent::Nothing; }
+  let sl_prev = screen_left16(pre);
+  let sl = screen_left16(s);
+  if *ext & 0x100 != 0 {
+    // AreaParserTaskNum (post-frame value): a burst of 8 tasks starts (value 7 after this frame) when
+    // ScrollThirtyTwo = ScreenLeft mod 32 wraps while no burst is running; the enemy loader skips frames with value 7 (F78).
+    let mut aptn = (*ext & 0xf) as i32;
+    if aptn > 0 { aptn -= 1; } else if (sl >> 5) > (sl_prev >> 5) { aptn = 7; }
+    if sl >= LIFT_SPAWN_SL && (aptn & 7) != 7 { *ext = 0; return LiftEvent::Spawn; }
+    *ext = 0x100 | aptn as u16;
+    return LiftEvent::Nothing;
+  }
+  let k = *ext + 1;
+  *ext = k;
+  let y_pre = lift_y_after(k - 1);
+  let y_post = lift_y_after(k);
+  let mut ev = LiftEvent::Nothing;
+  // LargePlatformCollision with Mario's box after this frame's movement (CheckPlayerVertical: skipped below Y $D0 / off the page)
+  if s.y_pos >= 0x10000 && s.y_pos < 0x1d000 {
+    let my = (s.y_pos >> 8) & 0xff;
+    let mx = s.x_pos >> 8;
+    // screen-relative box: GetXOffscreenBits marks the platform fully offscreen (no collision) when it is entirely
+    // right of the screen or entirely left of it; partially offscreen edges are clamped (CheckRight/LeftScreenBBox)
+    let rel = LIFT_X - sl;
+    let onscreen = rel < 256 && rel + LIFT_W >= 0;
+    let pl = if rel < 0 { 0 } else { rel };
+    let pr = if rel + LIFT_W > 255 { 255 } else { rel + LIFT_W };
+    let pt = y_pre & 0xff;
+    let pb = (y_pre + LIFT_H) & 0xff;
+    let ul = (mx - sl + 3) & 0xff; let ur = (mx - sl + 13) & 0xff; // small Mario: BoundBoxCtrlData[1] = x+3..x+13, y+$14..y+$20
+    let ut = (my + 0x14) & 0xff; let ub = (my + 0x20) & 0xff;
+    if onscreen && pl <= ur && ul <= pr && pt <= ub && ut <= pb {
+      if ((pb - ut) & 0xff) < 4 && s.y_spd < 0 { s.y_spd = 0x100 | (s.y_spd & 0xff); ev = LiftEvent::Bonk; } // head under the platform
+      if ((ub - pt) & 0xff) < 6 && s.y_spd >= 0 {
+        s.player_state = PlayerState::STANDING; ev = LiftEvent::Land; // SetCollisionFlag; PositionPlayerOnVPlat after the move
+      } else if ((ur - pl) & 0xff) < 8 {
+        if s.x_spd >= 0 { s.x_spd &= 0xff; s.x_pos -= 0x100; s.side_collision_timer = 0xf; s.collision_bits -= Dir::RIGHT; } // ImpedePlayerMove, left side of the platform
+        ev = LiftEvent::SideL;
+      } else if ((pr - ul - 1) & 0xff) < 9 {
+        if s.x_spd < 0x100 { s.x_spd &= 0xff; s.x_pos += 0x100; s.side_collision_timer = 0xf; s.collision_bits -= Dir::LEFT; } // right side
+        ev = LiftEvent::SideR;
+      }
+    }
+  }
+  if ev == LiftEvent::Land { s.y_pos = (s.y_pos & 0xff) | 0x10000 | ((y_post - 32) << 8); s.y_spd = 0; } // PositionPlayerOnVPlat: Y = lift Y - 32, Player_Y_Speed = Player_Y_MoveForce = 0; Player_YMF_Dummy (the y_pos fraction here) is NOT cleared
+  if sl >= LIFT_ERASE_SL { *ext = 0x200; if ev == LiftEvent::Nothing { ev = LiftEvent::Erase; } }
+  ev
+}
+type Hook = fn(&State, &mut State, &mut u16) -> LiftEvent;
+
+/// Generic replay (P2.3a): run a case's model from start_states()[0] through `n` NES-order records starting at
+/// `first`, optionally tracing each step in the trace11pipe row format. Returns (state, alive).
+fn replayc<C: case::SmbSearchCase>(data: &[u8], first: usize, n: usize, trace: bool) -> (State, bool) { let (s, _, a) = replayce::<C>(data, first, n, trace, None, 0); (s, a) }
+/// replayc with an optional per-frame object hook (e.g. the 4-2 lift) carrying `ext`; returns (state, ext, alive).
+fn replayce<C: case::SmbSearchCase>(data: &[u8], first: usize, n: usize, trace: bool, hook: Option<Hook>, ext0: u16) -> (State, u16, bool) {
+  use emu::{Emu, EmuResult};
+  use case::SmbSearchCase;
+  let mut s = C::start_states()[0].clone();
+  let mut ext = ext0;
+  if trace { println!("step x_pos y_pos x_spd y_spd state facing moving input result"); }
+  for i in 0..n {
+    let input = nes_to_model(data[first + i]);
+    let (mut ns, res) = <C as SmbSearchCase>::Emu::run_step(s.clone(), input);
+    let mut evs = String::new();
+    if let Some(h) = hook { if res == EmuResult::Success { let ev = h(&s, &mut ns, &mut ext); if ev != LiftEvent::Nothing || ext < 0x100 { evs = format!(" lift {:?} k {} y {}", ev, ext, if ext < 0x100 { lift_y_after(ext) } else { -1 }); } } }
+    if trace {
+      println!("{} {:#x} {:#x} {:#x} {:#x} {:?} {:?} {:?} {} {:?}{}", i, ns.x_pos, ns.y_pos, ns.x_spd, ns.y_spd, ns.player_state, ns.facing_dir, ns.moving_dir, input, res, evs);
+      if <<C as options::Options>::ScrollPos as options::ScrollPos>::TRACK_SCROLL_POS { println!("scroll: {} sct {}", ns.left_screen_edge_pos, ns.side_collision_timer); }
+    }
+    s = ns;
+    if res != EmuResult::Success { if trace { println!("stopped: {:?}", res); } return (s, ext, false); }
+  }
+  (s, ext, true)
+}
+
+/// Generic per-layer exhaustive BFS (P2.3a, see the `bfsc` mode): in-memory frontier, global visited set of
+/// compressed keys, parents/inputs kept per layer for path reconstruction, expansion over `threads` threads.
+/// The case's SearchGoal supplies the deadline heuristic (a lower bound on the steps still needed, so pruning
+/// `step + h > max_steps` is exact) and the goal test.
+fn bfsc_run<C: case::SmbSearchCase + 'static, A: state::StateArray + Send + 'static>(data: &[u8], first: usize, prefix: usize, max_steps: usize, out: Option<String>, check_path: usize, threads: usize, hook: Option<Hook>, ext0: u16, reduced: bool)
+    where C::SearchGoal: Send + Sync {
+  use emu::{Emu, EmuResult};
+  use heuristics::SearchGoal;
+  use state::{CompressedState, StateCompressor};
+  use std::collections::HashSet;
+  use std::sync::Arc;
+  type Key<C, A> = CompressedState<C, A>;
+  let (s, e0, alive) = replayce::<C>(data, first, prefix, false, hook, ext0);
+  assert!(alive, "prefix replay ended early");
+  println!("root after {} prefix steps (record {}): {}", prefix, first + prefix, s);
+  println!("object hook {} (root ext {:#x}); inputs: {}", hook.is_some(), e0, if reduced { "MrWint's reduced per-state set (SmbInputFetcher, F76 — not proven lossless)" } else { "all 16 A/B/L/R combinations" });
+  let t0 = time::precise_time_ns();
+  let goal = Arc::new(C::SearchGoal::new());
+  let hval = |g: &C::SearchGoal, st: &State, step: usize| -> Option<usize> { let mut c = st.clone(); g.distance_to_goal_heuristic(&mut c, step as state::Dist).map(|d| d as usize) };
+  println!("heuristic built in {:.1}s; at root: {:?} steps (deadline {} steps); threads {}", (time::precise_time_ns() - t0) as f64 / 1e9, hval(&goal, &s, 0), max_steps, threads);
+  // --check-path N: replay N more records of the input file as a reference path (e.g. the WR's own
+  // continuation) and report at every layer whether its state is in the frontier, else why not.
+  let mut refpath: Vec<(State, u16)> = Vec::new();
+  if check_path > 0 {
+    let (mut rs, mut re) = (s.clone(), e0);
+    for k in 0..check_path {
+      let input = nes_to_model(data[first + prefix + k]);
+      let (mut ns, res) = <C as case::SmbSearchCase>::Emu::run_step(rs.clone(), input);
+      if let Some(h) = hook { if res == EmuResult::Success { let ev = h(&rs, &mut ns, &mut re); if ev != LiftEvent::Nothing { println!("reference path: step {} object event {:?} ext {:#x}", k + 1, ev, re); } } }
+      let g = goal.is_goal_state(&ns, &res);
+      println!("reference path: step {} x {:#x} y {:#x} xspd {:#x} yspd {:#x} {:?} h {:?} result {:?}{}", k + 1, ns.x_pos, ns.y_pos, ns.x_spd, ns.y_spd, ns.player_state, hval(&goal, &ns, k + 1), res, if g { " GOAL" } else { "" });
+      if res != EmuResult::Success { break; }
+      refpath.push((ns.clone(), re));
+      rs = ns;
+    }
+  }
+  // model input bits: A 0x80, B 0x40, L 0x02, R 0x01
+  let inputs: Arc<Vec<u8>> = Arc::new((0..16u8).map(|k| { let mut v = 0u8; if k & 1 != 0 { v |= 0x80; } if k & 2 != 0 { v |= 0x40; } if k & 4 != 0 { v |= 0x02; } if k & 8 != 0 { v |= 0x01; } v }).collect());
+  let mut visited: HashSet<(Key<C, A>, u16)> = HashSet::new();
+  visited.insert((Key::<C, A>::from_state(&s), e0));
+  let mut frontier: Arc<Vec<(State, u16)>> = Arc::new(vec![(s.clone(), e0)]);
+  let mut parents: Vec<Vec<u32>> = vec![vec![0]];
+  let mut pinputs: Vec<Vec<u8>> = vec![vec![0]];
+  let mut step = 0;
+  let mut found: Option<(usize, u32, u8, State)> = None; // (step, parent index, input, goal state)
+  while step < max_steps {
+    let t1 = time::precise_time_ns();
+    let n = frontier.len();
+    let per = (n + threads - 1) / threads;
+    let mut handles = Vec::new();
+    for t in 0..threads {
+      let lo = t * per;
+      let hi = ::std::cmp::min(n, lo + per);
+      if lo >= hi { continue; }
+      let frontier = frontier.clone();
+      let inputs = inputs.clone();
+      let goal = goal.clone();
+      handles.push(::std::thread::spawn(move || {
+        let mut outv: Vec<(State, u16, u32, u8)> = Vec::new();
+        let mut goals: Vec<(u32, u8, State)> = Vec::new();
+        let (mut pruned, mut dead, mut other) = (0u64, 0u64, 0u64);
+        let mut max_x: i32 = 0;
+        for pi in lo..hi {
+          let (ref ps, pe) = frontier[pi];
+          let red: Vec<u8> = if reduced { <ida::SmbInputFetcher<C> as ida::InputFetcher>::valid_next_inputs(ps).iter().map(|i| i.bits()).collect() } else { Vec::new() };
+          for &ib in (if reduced { red.iter() } else { inputs.iter() }) {
+            let (mut ns, res) = <C as case::SmbSearchCase>::Emu::run_step(ps.clone(), emu::Input::from_bits_truncate(ib));
+            if goal.is_goal_state(&ns, &res) { goals.push((pi as u32, ib, ns)); continue; }
+            match res {
+              EmuResult::Success => {
+                let mut ne = pe;
+                if let Some(h) = hook { h(ps, &mut ns, &mut ne); }
+                if ns.y_pos >= 0x1d000 { dead += 1; continue; }
+                let mut c = ns.clone();
+                match goal.distance_to_goal_heuristic(&mut c, (step + 1) as state::Dist) {
+                  None => { pruned += 1; continue; }
+                  Some(hh) => { if step + 1 + hh as usize > max_steps { pruned += 1; continue; } }
+                }
+                if ns.x_pos > max_x { max_x = ns.x_pos; }
+                outv.push((ns, ne, pi as u32, ib));
+              }
+              _ => { other += 1; }
+            }
+          }
+        }
+        (outv, goals, pruned, dead, other, max_x)
+      }));
+    }
+    let mut next: Vec<(State, u16)> = Vec::new();
+    let mut npar: Vec<u32> = Vec::new();
+    let mut ninp: Vec<u8> = Vec::new();
+    let (mut dup, mut pruned, mut dead, mut other, mut goal_n) = (0u64, 0u64, 0u64, 0u64, 0u64);
+    let mut max_x: i32 = 0;
+    for hd in handles {
+      let (outv, goals, p1, d1, o1, mx) = hd.join().unwrap();
+      pruned += p1; dead += d1; other += o1;
+      if mx > max_x { max_x = mx; }
+      for (pi, ib, gs) in goals {
+        goal_n += 1;
+        if found.is_none() { found = Some((step + 1, pi, ib, gs)); }
+      }
+      for (ns, ne, pi, ib) in outv {
+        if !visited.insert((Key::<C, A>::from_state(&ns), ne)) { dup += 1; continue; }
+        next.push((ns, ne)); npar.push(pi); ninp.push(ib);
+      }
+    }
+    println!("layer {}: parents {} -> unique {}, dup {}, pruned {}, dead {}, other {}, goals {}; visited {}; max x {:#x}; {:.1}s",
+      step + 1, n, next.len(), dup, pruned, dead, other, goal_n, visited.len(), max_x, (time::precise_time_ns() - t1) as f64 / 1e9);
+    ::std::io::Write::flush(&mut ::std::io::stdout()).ok();
+    if step < refpath.len() {
+      let (ref rs, re) = refpath[step];
+      let key = (Key::<C, A>::from_state(rs), re);
+      let in_frontier = next.iter().any(|&(ref st, se)| se == re && Key::<C, A>::from_state(st) == key.0);
+      let hh = hval(&goal, rs, step + 1);
+      println!("  check-path step {}: {} (h {:?}, {}{})", step + 1, if in_frontier { "in frontier" } else { "MISSING" }, hh,
+        match hh { Some(h) if step + 1 + h > max_steps => "would be PRUNED; ", None => "h None (PRUNED); ", _ => "" }, if visited.contains(&key) { "key visited" } else { "key not visited" });
+    }
+    if found.is_some() { println!("goal reached at layer {} ({} goal transitions)", step + 1, goal_n); break; }
+    if next.is_empty() { println!("no live states left after layer {}", step + 1); break; }
+    frontier = Arc::new(next);
+    parents.push(npar);
+    pinputs.push(ninp);
+    step += 1;
+  }
+  println!("total {:.1}s, {} states visited", (time::precise_time_ns() - t0) as f64 / 1e9, visited.len());
+  if let Some((gstep, ppi, pib, gs)) = found {
+    println!("earliest goal: step {} (record {} .. {}), state {}", gstep, first + prefix, first + prefix + gstep - 1, gs);
+    let mut seq: Vec<u8> = vec![pib];
+    let mut pi = ppi as usize;
+    let mut l = gstep - 1;
+    while l > 0 { seq.push(pinputs[l][pi]); pi = parents[l][pi] as usize; l -= 1; }
+    seq.reverse();
+    emu::print_rle(seq.iter().map(|&b| emu::Input::from_bits_truncate(b)));
+    if let Some(path) = out {
+      let nes: Vec<u8> = seq.iter().map(|&b| model_to_nes(b)).collect();
+      ::std::fs::write(&path, &nes).unwrap();
+      println!("wrote {} NES-order input bytes to {}", nes.len(), path);
+    }
+  } else { println!("no goal found within {} steps", max_steps); }
+}
+
+/// Compact per-layer BFS (P2.1b-m3), external-memory version: the frontier after `step` steps lives in
+/// `layer_dir/layer_NNN.bin` as sorted, deduplicated 16-byte records (compressed player key || goomba bits ||
+/// zero padding). Each layer: the parents are streamed from that file in blocks (never held in memory),
+/// expanded in parallel (`--threads`) into per-thread chunk buffers that are sorted+deduplicated into a bounded
+/// accumulator (`--acc-mb`, spilled to `layer_dir/tmp/run_*.bin` as sorted runs when full), and the runs are
+/// k-way merged (with dedup) straight into `layer_{NNN+1}.bin`. Memory ~ threads × (acc + chunks), independent of
+/// the frontier size. Dedup per layer only (no global visited set; the deadline bound keeps it finite).
+/// `--resume N` restarts at step N from an existing raw `layer_N.bin` (decompress `.xz` first). A grab's input
+/// path is reconstructed offline with `bfs11c-path` from the "grab parent record" line.
+fn bfs11c_run<C: case::SmbSearchCase + 'static, A: state::StateArray + Send + 'static>(data: &[u8], first: usize, prefix: usize, max_steps: usize, overrides: &[(usize, i16)], root_frame: i64, any_y: bool, goombas: bool, out: Option<String>, threads: usize, layer_dir: Option<String>, resume: Option<usize>, acc_mb: usize, stop_step: usize) {
+  use emu::{Emu, EmuResult};
+  use heuristics::BoundsHeuristic;
+  use state::{CompressedState, StateCompressor};
+  use std::collections::{BinaryHeap, HashMap};
+  use std::cmp::Reverse;
+  use std::fs::File;
+  use std::io::{BufReader, BufWriter, Read, Write};
+  use std::os::unix::fs::FileExt;
+  use std::sync::Arc;
+  type Key<C, A> = CompressedState<C, A>;
+  type Rec = [u8; 16];
+  fn rec_bytes(v: &[Rec]) -> &[u8] { unsafe { ::std::slice::from_raw_parts(v.as_ptr() as *const u8, v.len() * 16) } }
+  fn read_full_at(f: &File, buf: &mut [u8], mut off: u64) -> ::std::io::Result<()> {
+    let mut done = 0usize;
+    while done < buf.len() {
+      let k = f.read_at(&mut buf[done..], off)?;
+      if k == 0 { return Err(::std::io::Error::new(::std::io::ErrorKind::UnexpectedEof, "short read")); }
+      done += k; off += k as u64;
+    }
+    Ok(())
+  }
+  let (s, g0, alive) = replay11::<C>(data, first, prefix, overrides, goombas, false);
+  assert!(alive, "prefix replay ended early");
+  let k0 = Key::<C, A>::from_state(&s);
+  let klen = k0.as_bytes().len();
+  assert!(klen + 1 <= 16);
+  {
+    let d = k0.decompress();
+    assert!(d == s || (Key::<C, A>::from_state(&d).as_bytes() == k0.as_bytes() && d.x_pos == s.x_pos && d.y_pos == s.y_pos && d.x_spd == s.x_spd && d.y_spd == s.y_spd && d.running_timer == s.running_timer), "decompress(compress(root)) != root:\n{}\nvs\n{}", d, s);
+  }
+  let ldir = layer_dir.unwrap_or_else(|| "bfs11c_layers".to_string());
+  ::std::fs::create_dir_all(format!("{}/tmp", ldir)).unwrap();
+  let layer_path = |l: usize| format!("{}/layer_{:03}.bin", ldir, l);
+  println!("root after {} prefix steps (frame {}): {}", prefix, root_frame, s);
+  println!("goombas {} (root g {:#x}); key {} bytes; threads {}; layer dir {}; acc {} MB/thread; resume {:?}", goombas, g0, klen, threads, ldir, acc_mb, resume);
+  let t0 = time::precise_time_ns();
+  let h = Arc::new(BoundsHeuristic::new::<C>(&vec![s.clone()]));
+  let target_x: i32 = 0xc5600;
+  let target_y: i32 = 0x1a200;
+  let hval0 = if any_y { h.get_steps_until_x_pos_at_least(&s, target_x) } else { h.get_steps_until_bounds_at_least(&s, target_x, target_y) };
+  println!("heuristic built in {:.1}s; at root: {} steps (deadline {} steps, any_y {})", (time::precise_time_ns() - t0) as f64 / 1e9, hval0, max_steps, any_y);
+  let inputs: Vec<u8> = (0..16u8).map(|k| { let mut v = 0u8; if k & 1 != 0 { v |= 0x80; } if k & 2 != 0 { v |= 0x40; } if k & 4 != 0 { v |= 0x02; } if k & 8 != 0 { v |= 0x01; } v }).collect();
+  let mut step = 0usize;
+  match resume {
+    Some(r) => {
+      let md = ::std::fs::metadata(layer_path(r)).expect("--resume: layer file missing (decompress the .xz first)");
+      assert!(md.len() % 16 == 0 && md.len() > 0, "--resume: bad layer file size");
+      step = r;
+      println!("resuming at step {} from {} ({} records)", r, layer_path(r), md.len() / 16);
+    }
+    None => {
+      let mut r0: Rec = [0; 16];
+      r0[..klen].copy_from_slice(k0.as_bytes());
+      r0[klen] = g0;
+      File::create(layer_path(0)).unwrap().write_all(&r0[..]).unwrap();
+    }
+  }
+  let acc_limit: usize = ::std::cmp::max(1, acc_mb * 1024 * 1024 / 16);
+  let mut grabs: HashMap<(usize, i32, i32, bool), u32> = HashMap::new();
+  // first grab per (step, fpg): (parent record, input, grab state)
+  let mut grab_paths: HashMap<(usize, bool), (Rec, u8, State)> = HashMap::new();
+  while step < max_steps {
+    if step >= stop_step { println!("stopping at step {} (--stop-step)", step); break; }
+    let t1 = time::precise_time_ns();
+    let f = root_frame + step as i64 + 1;
+    let ppath = layer_path(step);
+    let n = (::std::fs::metadata(&ppath).unwrap().len() / 16) as usize;
+    let per = (n + threads - 1) / threads;
+    let mut handles = Vec::new();
+    for t in 0..threads {
+      let lo = t * per;
+      let hi = ::std::cmp::min(n, lo + per);
+      if lo >= hi { continue; }
+      let h = h.clone();
+      let inputs = inputs.clone();
+      let ppath = ppath.clone();
+      let run_prefix = format!("{}/tmp/run_{:03}_{:02}", ldir, step, t);
+      handles.push(::std::thread::spawn(move || {
+        const CHUNK: usize = 1 << 21; // records per chunk buffer (32 MB)
+        const BLOCK: usize = 1 << 16; // parent records per read
+        let file = File::open(&ppath).unwrap();
+        let mut rbuf: Vec<u8> = vec![0u8; BLOCK * 16];
+        let mut acc: Vec<Rec> = Vec::new();
+        let mut buf: Vec<Rec> = Vec::with_capacity(CHUNK);
+        let mut acc_runs = 0usize;
+        let mut runs: Vec<String> = Vec::new();
+        let (mut gen, mut pruned, mut dead, mut other, mut stomps, mut grab_n) = (0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
+        let mut max_x: i32 = 0;
+        let mut lgrabs: Vec<(i32, i32, bool, Rec, u8, State)> = Vec::new();
+        let spill = |acc: &mut Vec<Rec>, runs: &mut Vec<String>| {
+          let path = format!("{}_{:03}.bin", run_prefix, runs.len());
+          let mut w = BufWriter::with_capacity(1 << 22, File::create(&path).unwrap());
+          w.write_all(rec_bytes(&acc[..])).unwrap();
+          w.flush().unwrap();
+          runs.push(path);
+          acc.clear();
+          acc.shrink_to_fit();
+        };
+        let mut pos = lo;
+        while pos < hi {
+          let cnt = ::std::cmp::min(BLOCK, hi - pos);
+          read_full_at(&file, &mut rbuf[..cnt * 16], (pos * 16) as u64).unwrap();
+          for i in 0..cnt {
+            let mut rec: Rec = [0; 16];
+            rec.copy_from_slice(&rbuf[i * 16..(i + 1) * 16]);
+            let key = Key::<C, A>::from_bytes(&rec[..klen]);
+            let pg = rec[klen];
+            let ps = key.decompress();
+            for &ib in &inputs {
+              let (mut ns, res) = <C as case::SmbSearchCase>::Emu::run_step(ps.clone(), emu::Input::from_bits_truncate(ib));
+              match res {
+                EmuResult::StateChangeFlag(cx, cy) => {
+                  grab_n += 1;
+                  let fpg = ns.y_pos >= target_y;
+                  if cx != 0xc6 { println!("note: flag collision at column {} row {} (x {:#x} y {:#x})", cx, cy, ns.x_pos, ns.y_pos); }
+                  lgrabs.push((ns.x_pos, ns.y_pos, fpg, rec, ib, ns));
+                }
+                EmuResult::Success => {
+                  if ns.y_pos >= 0x1d000 { dead += 1; continue; }
+                  let mut ng = pg;
+                  if goombas {
+                    match room_enemies(f, &mut ns, &mut ng) {
+                      RoomEvent::Death => { dead += 1; continue; }
+                      RoomEvent::Stomp(_) => { stomps += 1; }
+                      RoomEvent::Nothing => {}
+                    }
+                  }
+                  let hh = if any_y { h.get_steps_until_x_pos_at_least(&ns, target_x) as usize } else { h.get_steps_until_bounds_at_least(&ns, target_x, target_y) as usize };
+                  if step + 1 + hh > max_steps { pruned += 1; continue; }
+                  if ns.x_pos > max_x { max_x = ns.x_pos; }
+                  let k = Key::<C, A>::from_state(&ns);
+                  let mut r: Rec = [0; 16];
+                  r[..klen].copy_from_slice(k.as_bytes());
+                  r[klen] = ng;
+                  buf.push(r);
+                  gen += 1;
+                }
+                _ => { other += 1; }
+              }
+            }
+            if buf.len() >= CHUNK {
+              buf.sort_unstable(); buf.dedup();
+              acc.append(&mut buf);
+              acc_runs += 1;
+              if acc_runs >= 2 {
+                acc.sort_unstable(); acc.dedup(); acc_runs = 0;
+                if acc.len() >= acc_limit { spill(&mut acc, &mut runs); }
+              }
+            }
+          }
+          pos += cnt;
+        }
+        buf.sort_unstable(); buf.dedup();
+        acc.append(&mut buf);
+        acc.sort_unstable(); acc.dedup();
+        if !acc.is_empty() { spill(&mut acc, &mut runs); }
+        (runs, gen, pruned, dead, other, stomps, grab_n, max_x, lgrabs)
+      }));
+    }
+    let mut runs: Vec<String> = Vec::new();
+    let (mut gen, mut pruned, mut dead, mut other, mut stomps, mut grab_n) = (0u64, 0u64, 0u64, 0u64, 0u64, 0u64);
+    let mut max_x: i32 = 0;
+    for hd in handles {
+      let (mut r1, g1, p1, d1, o1, s1, gr1, mx, lgrabs) = hd.join().unwrap();
+      gen += g1; pruned += p1; dead += d1; other += o1; stomps += s1; grab_n += gr1;
+      if mx > max_x { max_x = mx; }
+      runs.append(&mut r1);
+      for (x, y, fpg, rec, ib, gs) in lgrabs {
+        *grabs.entry((step + 1, x, y, fpg)).or_insert(0) += 1;
+        grab_paths.entry((step + 1, fpg)).or_insert((rec, ib, gs));
+      }
+    }
+    let t2 = time::precise_time_ns();
+    // k-way merge of the sorted runs (dedup on output) into the next layer file
+    let mut readers: Vec<BufReader<File>> = runs.iter().map(|p| BufReader::with_capacity(1 << 22, File::open(p).unwrap())).collect();
+    let mut heap: BinaryHeap<Reverse<(Rec, usize)>> = BinaryHeap::new();
+    for (i, rd) in readers.iter_mut().enumerate() {
+      let mut r: Rec = [0; 16];
+      if rd.read_exact(&mut r).is_ok() { heap.push(Reverse((r, i))); }
+    }
+    let mut w = BufWriter::with_capacity(1 << 23, File::create(layer_path(step + 1)).unwrap());
+    let mut unique: u64 = 0;
+    let mut last: Option<Rec> = None;
+    while let Some(Reverse((r, i))) = heap.pop() {
+      if last.map_or(true, |l| l != r) { w.write_all(&r[..]).unwrap(); unique += 1; last = Some(r); }
+      let mut nr: Rec = [0; 16];
+      if readers[i].read_exact(&mut nr).is_ok() { heap.push(Reverse((nr, i))); }
+    }
+    w.flush().unwrap();
+    drop(w);
+    drop(readers);
+    for p in &runs { ::std::fs::remove_file(p).ok(); }
+    let t3 = time::precise_time_ns();
+    println!("layer {} (after frame {}): parents {} -> unique {}, generated {}, pruned {}, dead {}, other {}, stomps {}, grabs {}; max x {:#x}; {:.1}s (expand {:.1}s, merge {:.1}s of {} runs)",
+      step + 1, f, n, unique, gen, pruned, dead, other, stomps, grab_n, max_x, (t3 - t1) as f64 / 1e9, (t2 - t1) as f64 / 1e9, (t3 - t2) as f64 / 1e9, runs.len());
+    ::std::io::stdout().flush().ok();
+    if unique == 0 { println!("no live states left after layer {}", step + 1); break; }
+    step += 1;
+  }
+  println!("total {:.1}s", (time::precise_time_ns() - t0) as f64 / 1e9);
+  let mut gl: Vec<(&(usize, i32, i32, bool), &u32)> = grabs.iter().collect();
+  gl.sort();
+  println!("grabs (step frame x_pos y_pos fpg count):");
+  for (k, c) in gl { println!("  {} {} {:#x} {:#x} {} {}", k.0, root_frame + k.0 as i64, k.1, k.2, k.3, c); }
+  let mut best: Option<(usize, bool)> = None;
+  for fpg in &[true, false] {
+    let mut keys: Vec<&(usize, bool)> = grab_paths.keys().filter(|k| k.1 == *fpg).collect();
+    keys.sort();
+    if let Some(k) = keys.first() { best = Some(**k); break; }
+  }
+  if let Some((bstep, bfpg)) = best {
+    let &(prec, pib, ref gs) = grab_paths.get(&(bstep, bfpg)).unwrap();
+    println!("earliest {} grab: step {} (frame {}), state {}", if bfpg { "FPG" } else { "non-FPG" }, bstep, root_frame + bstep as i64, gs);
+    println!("grab parent record: {:?} input {:#x}", &prec[..klen + 1], pib);
+    println!("reconstruct with: smb-opt bfs11c-path {} {} \"{:?}\" {:#x} [--goombas] [--relaxed] --root-frame {} --out FILE", ldir, bstep - 1, &prec[..klen + 1], pib, root_frame);
+    if out.is_some() { println!("(--out: pass it to bfs11c-path to write the reconstructed inputs)"); }
+  } else { println!("no grab found within {} steps", max_steps); }
+}
+
+/// Backward path reconstruction from bfs11c layer files (full scan of each layer, threaded): for the target
+/// record of layer l, find any record of layer l-1 and input whose child (step + goombas at frame
+/// root_frame + l) equals it; repeat down to layer 0. Prints the input sequence (RLE) and writes NES-order bytes.
+fn bfs11c_path<C: case::SmbSearchCase + 'static, A: state::StateArray + Send + 'static>(layer_dir: &str, step: usize, rec_bytes: &[u8], grab_input: u8, goombas: bool, root_frame: i64, threads: usize, out: Option<String>) {
+  use emu::{Emu, EmuResult};
+  use state::{CompressedState, StateCompressor};
+  use std::sync::Arc;
+  type Key<C, A> = CompressedState<C, A>;
+  type Rec = [u8; 16];
+  let inputs: Vec<u8> = (0..16u8).map(|k| { let mut v = 0u8; if k & 1 != 0 { v |= 0x80; } if k & 2 != 0 { v |= 0x40; } if k & 4 != 0 { v |= 0x02; } if k & 8 != 0 { v |= 0x01; } v }).collect();
+  let mut target: Rec = [0; 16];
+  target[..rec_bytes.len()].copy_from_slice(rec_bytes);
+  let klen = Key::<C, A>::from_state(&case::w11::w11_pipe_start::<C>()).as_bytes().len();
+  assert!(rec_bytes.len() >= klen + 1, "record too short for this model ({} bytes, key {})", rec_bytes.len(), klen);
+  println!("target at layer {}: {:?} (x {:#x} y {:#x} g {:#x}); grab input {:#x}", step, &target[..klen + 1], Key::<C, A>::from_bytes(&target[..klen]).decompress().x_pos, Key::<C, A>::from_bytes(&target[..klen]).decompress().y_pos, target[klen], grab_input);
+  let mut seq: Vec<u8> = vec![grab_input];
+  let mut l = step;
+  while l > 0 {
+    let t1 = time::precise_time_ns();
+    let bytes = ::std::fs::read(format!("{}/layer_{:03}.bin", layer_dir, l - 1)).unwrap();
+    let n = bytes.len() / 16;
+    let recs: Arc<Vec<Rec>> = Arc::new((0..n).map(|i| { let mut r: Rec = [0; 16]; r.copy_from_slice(&bytes[i * 16..i * 16 + 16]); r }).collect());
+    drop(bytes);
+    let fl = root_frame + l as i64;
+    let per = (n + threads - 1) / threads;
+    let mut handles = Vec::new();
+    for t in 0..threads {
+      let lo = t * per; let hi = ::std::cmp::min(n, lo + per);
+      if lo >= hi { continue; }
+      let recs = recs.clone(); let inputs = inputs.clone(); let target = target;
+      handles.push(::std::thread::spawn(move || -> Option<(Rec, u8)> {
+        for idx in lo..hi {
+          let r = recs[idx];
+          let ps = Key::<C, A>::from_bytes(&r[..klen]).decompress();
+          let pg = r[klen];
+          for &ib in &inputs {
+            let (mut ns, res) = <C as case::SmbSearchCase>::Emu::run_step(ps.clone(), emu::Input::from_bits_truncate(ib));
+            if res != EmuResult::Success || ns.y_pos >= 0x1d000 { continue; }
+            let mut ng = pg;
+            if goombas { if let RoomEvent::Death = room_enemies(fl, &mut ns, &mut ng) { continue; } }
+            if ng != target[klen] { continue; }
+            if Key::<C, A>::from_state(&ns).as_bytes() == &target[..klen] { return Some((r, ib)); }
+          }
+        }
+        None
+      }));
+    }
+    let mut found: Option<(Rec, u8)> = None;
+    for hd in handles { if let Some(f) = hd.join().unwrap() { if found.is_none() { found = Some(f); } } }
+    match found {
+      Some((r, ib)) => {
+        println!("layer {}: parent found among {} records in {:.1}s (input {:#x})", l - 1, n, (time::precise_time_ns() - t1) as f64 / 1e9, ib);
+        seq.push(ib); target = r; l -= 1;
+      }
+      None => { println!("reconstruction FAILED at layer {} ({} records)", l - 1, n); break; }
+    }
+  }
+  seq.reverse();
+  emu::print_rle(seq.iter().map(|&b| emu::Input::from_bits_truncate(b)));
+  if let Some(path) = out {
+    let nes: Vec<u8> = seq.iter().map(|&b| model_to_nes(b)).collect();
+    ::std::fs::write(&path, &nes).unwrap();
+    println!("wrote {} NES-order input bytes to {}", nes.len(), path);
+  }
+}
