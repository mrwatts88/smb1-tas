+    type Key = CompressedState<BCase, [u8; 11]>;
+    let data = ::std::fs::read(&args[2]).unwrap();
+    let first: usize = args[3].parse().unwrap();
+    let prefix: usize = args[4].parse().unwrap();
+    let max_steps: usize = args[5].parse().unwrap();
+    let mut overrides: Vec<(usize, i16)> = Vec::new();
+    let mut root_frame: i64 = -1;
+    let mut any_y = false;
+    let mut out: Option<String> = None;
+    let mut i = 6;
+    while i < args.len() {
+      if args[i] == "--root-frame" { root_frame = args[i + 1].parse().unwrap(); i += 2; }
+      else if args[i] == "--any-y" { any_y = true; i += 1; }
+      else if args[i] == "--out" { out = Some(args[i + 1].clone()); i += 2; }
+      else { let parts: Vec<&str> = args[i].split(":yspd=").collect(); overrides.push((parts[0].parse().unwrap(), parts[1].parse().unwrap())); i += 1; }
+    }
+    let mut s = case::w11::w11_pipe_start::<BCase>();
+    for st in 0..prefix {
+      let b = data[first + st];
+      let mut v: u8 = 0;
+      for bit in 0..8 { if b & (1 << bit) != 0 { v |= 0x80 >> bit; } }
+      for &(ost, ys) in &overrides { if ost == st { s.y_spd = ys; s.player_state = state::PlayerState::JUMPING; } }
+      let (ns, res) = <BCase as SmbSearchCase>::Emu::run_step(s, emu::Input::from_bits_truncate(v));
+      assert!(res == EmuResult::Success, "prefix step {} gave {:?}", st, res);
+      s = ns;
+    }
+    println!("root after {} prefix steps (frame {}): {}", prefix, root_frame, s);
+    let t0 = time::precise_time_ns();
+    let h = BoundsHeuristic::new::<BCase>(&vec![s.clone()]);
+    let target_x: i32 = 0xc5600;
+    let target_y: i32 = 0x1a200;
+    let hval = |st: &State| -> usize { if any_y { h.get_steps_until_x_pos_at_least(st, target_x) as usize } else { h.get_steps_until_bounds_at_least(st, target_x, target_y) as usize } };
+    println!("heuristic built in {:.1}s; at root: {} steps (deadline {} steps, any_y {})", (time::precise_time_ns() - t0) as f64 / 1e9, hval(&s), max_steps, any_y);
+    // model input bits: A 0x80, B 0x40, L 0x02, R 0x01
+    let inputs: Vec<u8> = (0..16u8).map(|k| { let mut v = 0u8; if k & 1 != 0 { v |= 0x80; } if k & 2 != 0 { v |= 0x40; } if k & 4 != 0 { v |= 0x02; } if k & 8 != 0 { v |= 0x01; } v }).collect();
+    let mut visited: HashSet<Key> = HashSet::new();
+    visited.insert(Key::from_state(&s));
+    let mut frontier: Vec<State> = vec![s.clone()];
+    let mut parents: Vec<Vec<u32>> = vec![vec![0]];
+    let mut pinputs: Vec<Vec<u8>> = vec![vec![0]];
+    // grabs: (step, x_pos, y_pos, fpg) -> count; grab_paths: first (parent index, input, state) per (step, fpg)
+    let mut grabs: HashMap<(usize, i32, i32, bool), u32> = HashMap::new();
+    let mut grab_paths: HashMap<(usize, bool), (u32, u8, State)> = HashMap::new();
+    let mut step = 0;
+    while step < max_steps {
+      let t1 = time::precise_time_ns();
+      let mut next: Vec<State> = Vec::new();
+      let mut npar: Vec<u32> = Vec::new();
+      let mut ninp: Vec<u8> = Vec::new();
+      let (mut dup, mut pruned, mut dead, mut other, mut grab_n) = (0u64, 0u64, 0u64, 0u64, 0u64);
+      let mut max_x: i32 = 0;
+      for (pi, ps) in frontier.iter().enumerate() {
+        for &ib in &inputs {
+          let (ns, res) = <BCase as SmbSearchCase>::Emu::run_step(ps.clone(), emu::Input::from_bits_truncate(ib));
+          match res {
+            EmuResult::StateChangeFlag(cx, cy) => {
+              grab_n += 1;
+              let fpg = ns.y_pos >= target_y;
+              *grabs.entry((step + 1, ns.x_pos, ns.y_pos, fpg)).or_insert(0) += 1;
+              if cx != 0xc6 { println!("note: flag collision at column {} row {} (x {:#x} y {:#x})", cx, cy, ns.x_pos, ns.y_pos); }
+              grab_paths.entry((step + 1, fpg)).or_insert((pi as u32, ib, ns.clone()));
+            }
+            EmuResult::Success => {
+              if ns.y_pos >= 0x1d000 { dead += 1; continue; }
+              let hh = hval(&ns);
+              if step + 1 + hh > max_steps { pruned += 1; continue; }
+              if !visited.insert(Key::from_state(&ns)) { dup += 1; continue; }
+              if ns.x_pos > max_x { max_x = ns.x_pos; }
+              next.push(ns); npar.push(pi as u32); ninp.push(ib);
+            }
+            _ => { other += 1; }
+          }
+        }
+      }
+      println!("layer {} (after frame {}): parents {} -> unique {}, dup {}, pruned {}, dead {}, other {}, grabs {}; visited {}; max x {:#x}; {:.1}s",
+        step + 1, root_frame + step as i64 + 1, frontier.len(), next.len(), dup, pruned, dead, other, grab_n, visited.len(), max_x, (time::precise_time_ns() - t1) as f64 / 1e9);
+      if next.is_empty() { println!("no live states left after layer {}", step + 1); break; }
+      frontier = next;
+      parents.push(npar);
+      pinputs.push(ninp);
+      step += 1;
+    }
+    println!("total {:.1}s, {} states visited", (time::precise_time_ns() - t0) as f64 / 1e9, visited.len());
+    let mut gl: Vec<(&(usize, i32, i32, bool), &u32)> = grabs.iter().collect();
+    gl.sort();
+    println!("grabs (step frame x_pos y_pos fpg count):");
+    for (k, c) in gl { println!("  {} {} {:#x} {:#x} {} {}", k.0, root_frame + k.0 as i64, k.1, k.2, k.3, c); }
+    let mut best: Option<(usize, bool)> = None;
+    for fpg in &[true, false] {
+      let mut keys: Vec<&(usize, bool)> = grab_paths.keys().filter(|k| k.1 == *fpg).collect();
+      keys.sort();
+      if let Some(k) = keys.first() { best = Some(**k); break; }
+    }
+    if let Some((bstep, bfpg)) = best {
+      let &(ppi, pib, ref gs) = grab_paths.get(&(bstep, bfpg)).unwrap();
+      println!("earliest {} grab: step {} (frame {}), state {}", if bfpg { "FPG" } else { "non-FPG" }, bstep, root_frame + bstep as i64, gs);
+      let mut seq: Vec<u8> = vec![pib];
+      let mut pi = ppi as usize;
+      let mut l = bstep - 1;
+      while l > 0 { seq.push(pinputs[l][pi]); pi = parents[l][pi] as usize; l -= 1; }
+      seq.reverse();
+      emu::print_rle(seq.iter().map(|&b| emu::Input::from_bits_truncate(b)));
+      if let Some(path) = out {
+        let nes: Vec<u8> = seq.iter().map(|&b| { let mut v = 0u8; for bit in 0..8 { if b & (1 << bit) != 0 { v |= 0x80 >> bit; } } v }).collect();
+        ::std::fs::write(&path, &nes).unwrap();
+        println!("wrote {} NES-order input bytes to {}", nes.len(), path);
+      }
+    } else { println!("no grab found within {} steps", max_steps); }
+    return;
+  }
+  if args.len() >= 4 && args[1] == "trace11pipe" {
+    // trace11pipe INPUTS.bin FIRST_RECORD N : run the 1-1 third-room model from w11_pipe_start with
+    // NES-order input bytes (A=$01 B=$02 Sel=$04 Start=$08 U=$10 D=$20 L=$40 R=$80) records FIRST_RECORD..
+    use case::SmbSearchCase;
+    use emu::Emu;
+    let data = ::std::fs::read(&args[2]).unwrap();
+    let first: usize = args[3].parse().unwrap();
+    let n: usize = args[4].parse().unwrap();
+    // optional overrides: "STEP:yspd=VALUE" (applied before running the step's input), e.g. 65:yspd=-1024
+    let mut overrides: Vec<(usize, i16)> = Vec::new();
+    for a in args.iter().skip(5) { let parts: Vec<&str> = a.split(":yspd=").collect(); overrides.push((parts[0].parse().unwrap(), parts[1].parse().unwrap())); }
+    let mut s = case::w11::w11_pipe_start::<case::w11::W11PipeSpeedup>();
+    println!("step x_pos y_pos x_spd y_spd state facing moving input result");
+    for i in 0..n {
+      let b = data[first + i];
+      let mut v: u8 = 0;
+      for bit in 0..8 { if b & (1 << bit) != 0 { v |= 0x80 >> bit; } }
+      let input = emu::Input::from_bits_truncate(v);
+      for &(st, ys) in &overrides { if st == i { s.y_spd = ys; s.player_state = state::PlayerState::JUMPING; } }
+      let (ns, res) = <case::w11::W11PipeSpeedup as SmbSearchCase>::Emu::run_step(s, input);
+      println!("{} {:#x} {:#x} {:#x} {:#x} {:?} {:?} {:?} {} {:?}", i, ns.x_pos, ns.y_pos, ns.x_spd, ns.y_spd, ns.player_state, ns.facing_dir, ns.moving_dir, input, res);
+      s = ns;
+      if res != emu::EmuResult::Success { println!("stopped: {:?}", res); break; }
+    }
+    return;
+  }
+  if args.len() >= 3 && args[1] == "xpos-dump" {
+    use case::SmbSearchCase;
+    let h = heuristics::xpos::XPosHeuristic::new::<case::w11::W11PipeSpeedup>(&<case::w11::W11PipeSpeedup as SmbSearchCase>::start_states());
+    h.dump(&args[2]);
+    println!("dumped");
+    return;
+  }
+  if args.len() >= 3 && args[1] == "case" {
+    match args[2].as_str() {
+      "W11Speedup" => case::w11::W11Speedup::run(),
+      "W11PipeSpeedup" => case::w11::W11PipeSpeedup::run(),
+      "W11Flag" => case::w11::W11Flag::run(),
+      "W11Flag2" => case::w11::W11Flag2::run(),
+      "W11VertPipeEntry" => case::w11::W11VertPipeEntry::run(),
+      "W11SubSpeedup" => case::w11::W11SubSpeedup::run(),
+      "W84Part4Speedup" => case::w84::W84Part4Speedup::run(),
+      other => println!("unknown case {}", other),
+    }
+    return;
+  }
