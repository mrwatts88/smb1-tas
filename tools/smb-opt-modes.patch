+  type BlockBounce = WithBlockBounceTimer;
+  type BlockStates = W42MainBlocks;
+}
+/// 4-2 main area block states (P2.3b-2): the 16 cells of BB42 that change after a bounce — question blocks $c0
+/// (50,3) (51,3) (50,7) (51,7) (54,7) (56,7), the powerup block $c1 (55,7), hidden coin blocks $5f (64,5) (63,6)
+/// (65,6) (66,7), item bricks $5a (28,7) (mushroom), $5b (64,3) (vine), $5c (81,7) (star), and the coin bricks $5d
+/// (43,2) (77,7). The 269 plain bricks $52 only bounce. The spawned items (mushroom/star/vine) are NOT modeled: a
+/// route that bumps (28,7)/(55,7)/(81,7)/(64,3) is outside the model (STATUS "Model omissions"). The parser starts at
+/// absolute column 24 (CurrentPageLoc 1, CurrentColumnPos 8 on row 6585).
+#[allow(dead_code)]
+pub enum W42MainBlocks {}
+impl BlockStates for W42MainBlocks {
+  const ON: bool = true;
+  const BITS: usize = 56;
+  const CELLS: &'static [(usize, usize, bool)] = &[(43, 2, true), (50, 3, false), (51, 3, false), (64, 3, false), (64, 5, false), (63, 6, false), (65, 6, false), (28, 7, false), (50, 7, false), (51, 7, false), (54, 7, false), (55, 7, false), (56, 7, false), (66, 7, false), (77, 7, true), (81, 7, false)];
+  const PARSER_COL0: u8 = 24;
+  const IP0: u8 = 4; const FC0: u8 = 41; const GT0: u8 = 24;
+}
+impl super::SmbSearchCase for W42Main {
+  type SearchGoal = Self;
+  type StateStore = ::store::VecHashMap<CompressedState<Self, [u8; 20]>, Dist>;
+
+  type BlockBuffer = BB42;
