+      println!("{} {:#x} {:#x} {:#x} {:#x} {:?} {:?} {:?} {} {:?}{}", i, ns.x_pos, ns.y_pos, ns.x_spd, ns.y_spd, ns.player_state, ns.facing_dir, ns.moving_dir, input, res, evs);
+      if let Some(h) = bounds {
+        let v: Vec<String> = (1..=40usize).map(|k| match h.max_gain_from(&ns, k) { Some(g) => g.to_string(), None => "?".to_string() }).collect();
+        println!("bounds: {}", v.join(" "));
+      }
+    }
+    s = ns;
+    if res != EmuResult::Success { if trace { println!("stopped: {:?}", res); } return (s, g, false); }
+    if ev == RoomEvent::Death { if trace { println!("stopped: death"); } return (s, g, false); }
+  }
+  (s, g, true)
+}
