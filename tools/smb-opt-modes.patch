+//! World 4-2 cases (P2.3a): the main area from the entrance to the wrong-warp pipe (page 5 col 4 row 8) and the
+//! warp zone (AreaPointer $2F) from its entrance to the world-8 pipe (page 3 col 2 row 8). Block buffers BB42 /
+//! BB42Warp come from the WR dump (data/blockmaps/). Exact model options = W11PipeSpeedup's (running timer on).
+use blockbuffer::world4::*;
+use emu::{Emu, EmuResult, SmbEmu};
+#[allow(unused_imports)] use emu::inputs::*;
+use heuristics::SearchGoal;
+use heuristics::drift::DriftBound;
+use heuristics::xpos::XPosHeuristic;
+use heuristics::ygate::{surfaces_from_blocks, Surface, YGate};
+use options::*;
+use state::{CompressedState, Dir, Dist, PlayerState, State};
+
+/// 4-2 main-area start: Mario drops in at x 40 from the top (same pattern as w12_start; the WR's control row
+/// 6585 is x 40, y 48, y speed 2, FALLING).
+fn w42_start<O: Options>() -> State {
+  let mut s = SmbEmu::<O, BB42>::iterate_entrance(State {
+    x_pos: 0x2800,
+    y_pos: 0x12000,
+    x_spd: 0x0,
+    v_force: O::Platform::V_FORCE_AREA_INIT,
+    y_spd: 0x0,
+    v_force_down: O::Platform::V_FORCE_AREA_INIT,
+    facing_dir: Dir::RIGHT,
+    moving_dir: Dir::empty(),
+    player_state: PlayerState::FALLING,
+    x_spd_abs: 0,
+    running_speed: false,
+    collision_bits: Dir::LR,
+    side_collision_timer: 0,
+    left_screen_edge_pos: 0x0,
+    jump_swim_timer: 0,
+    running_timer : 0,
+    is_crouching: false,
+    collected_coins: 0,
+    powerup_block_hit: false,
+    powerup_collected: false,
+    parity: 0,
+    a_held: false, block_bounce_timer: 0, blocks: Default::default(),
+  });
+  // Block-state bookkeeping as of the WR dump's row 6585 (the state before record 6584 acts; the entrance iteration
+  // above does not know these): IntervalTimerControl 4, FrameCounter 41, AreaParserTaskNum 0, CurrentPageLoc 1 /
+  // CurrentColumnPos 8, GameTimerCtrlTimer 24, VRAM_Buffer1 non-empty with VRAM_Buffer_AddrCtrl 0 (flushed by the next NMI), BrickCoinTimer/Flag 0.
+  if O::BlockStates::ON {
+    s.blocks = ::state::BlockStateData { parser_col: O::BlockStates::PARSER_COL0, vbuf1: true, ..Default::default() };
+  }
+  s
+}
+
+/// 4-2 warp-zone start: Mario standing at x 24, y 176 (the WR's control row 7248).
+fn w42_warp_start<O: Options>() -> State {
+  State {
+    x_pos: 0x1800,
+    y_pos: 0x1b000,
+    x_spd: 0x0,
+    v_force: O::Platform::V_FORCE_AREA_INIT,
+    y_spd: 0x0,
+    v_force_down: O::Platform::V_FORCE_AREA_INIT,
+    facing_dir: Dir::RIGHT,
+    moving_dir: Dir::empty(),
+    player_state: PlayerState::STANDING,
+    x_spd_abs: 0,
+    running_speed: false,
+    collision_bits: Dir::LR,
+    side_collision_timer: 0,
+    left_screen_edge_pos: 0x0,
+    jump_swim_timer: 0,
+    running_timer : 0,
+    is_crouching: false,
+    collected_coins: 0,
+    powerup_block_hit: false,
+    powerup_collected: false,
+    parity: 0,
+    a_held: false, block_bounce_timer: 0, blocks: Default::default(),
+  }
+}
+
+/// Coin handler over a fixed list of coin cells (one state bit per coin). A head/foot/side touch of an
+/// uncollected coin collects it and ends the collision routine for that frame (AwardTouchedCoin ->
+/// HandleCoinMetatile -> rts: no landing, no side impede that frame), so coins on the route must be modeled
+/// exactly; IgnoreCoins treats every coin as already gone. Unknown cells are treated as collected.
+macro_rules! coin_list_handler {
+  ($name:ident, $n:expr, [$(($x:expr, $y:expr)),*]) => {
+    #[allow(dead_code)]
+    pub enum $name {}
+    impl $name {
+      const COINS: [(usize, usize); $n] = [$(($x, $y)),*];
+    }
+    impl CoinHandler for $name {
+      const COIN_HANDLER_BITS: usize = $n;
+      fn is_coin_collected(s: &State, cx: usize, cy: usize) -> bool {
+        for (i, c) in Self::COINS.iter().enumerate() { if c.0 == cx && c.1 == cy { return s.collected_coins & (1 << i) != 0; } }
+        true
+      }
+      fn collect_coin(s: &mut State, cx: usize, cy: usize) -> () {
+        for (i, c) in Self::COINS.iter().enumerate() { if c.0 == cx && c.1 == cy { s.collected_coins |= 1 << i; } }
+      }
+    }
+  }
+}
+/// 4-2 main area: 3 coins in the bottom corridor's ceiling (row 10, columns 27..29).
+coin_list_handler!(W42MainCoins, 3, [(27, 10), (28, 10), (29, 10)]);
