+    let m = clamp(m, M_LO, M_HI); if x > WALL + m { return 0; }
+    let d = self.dist[self.idx(x, clamp(y, 0, NY - 1), m, clamp(c, 0, self.cmax))];
+    if d == INF { 1000 } else { d as u16 }
+  }
