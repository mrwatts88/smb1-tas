+    let gate = YGate::new::<NTSC>((gy >> 8) - 0x100, surf);
+    println!("W42Main position goal x >= {} Y <= {}{}: {}", gx >> 8, (gy >> 8) - 0x100, if self.bounce_band { " (enemy-aware: bounce band)" } else { "" }, gate.describe());
