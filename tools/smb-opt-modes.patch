+        if !b.coin_brick_flag { b.coin_brick_flag = true; b.coin_brick_timer = 11; }
+        else if b.coin_brick_timer == 0 { b.used |= 1u16 << i; }
+      } else { self.s.blocks.used |= 1u16 << i; }
+    }
+  }
